<UserControl x:Class="MultiFunPlayer.UI.Controls.Views.PluginStatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:material="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:plugin="clr-namespace:MultiFunPlayer.Plugin"
             xmlns:s="https://github.com/canton7/Stylet"
             d:DesignHeight="450"
             d:DesignWidth="800"
             x:ClassModifier="internal"
             mc:Ignorable="d">
    <DockPanel MinWidth="200"
               MaxHeight="400"
               LastChildFill="True">
        <material:ColorZone DockPanel.Dock="Top"
                            Background="{DynamicResource PrimaryHueMidBrush}"
                            CornerRadius="4 4 0 0">
            <Grid Margin="0 0 0 5">
                <TextBlock Margin="10 8 0 0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryHueMidForegroundBrush}"
                           Text="插件"
                           Typography.Capitals="AllSmallCaps"/>

                <Button Style="{StaticResource MaterialDesignFlatButton}"
                        Width="24"
                        Height="24"
                        Margin="0 5 5 0"
                        Padding="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        material:RippleAssist.Feedback="{DynamicResource PrimaryHueMidForegroundBrush}"
                        Command="{x:Static material:DialogHost.CloseDialogCommand}"
                        Foreground="{DynamicResource PrimaryHueMidForegroundBrush}">
                    <material:PackIcon Width="20"
                                       Height="20"
                                       Kind="Close"/>
                </Button>
            </Grid>
        </material:ColorZone>

        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Containers}" Margin="0 5 0 5">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <material:Card MinWidth="400" Margin="10 5 10 5">
                            <DockPanel LastChildFill="False">
                                <material:ColorZone Width="30" Height="30">
                                    <material:ColorZone.Resources>
                                        <Style TargetType="material:ColorZone">
                                            <Setter Property="ToolTip" Value="空闲"/>

                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding State}" Value="{x:Static plugin:PluginState.Compiling}">
                                                    <Setter Property="ToolTip" Value="编译中"/>
                                                </DataTrigger>

                                                <DataTrigger Binding="{Binding State}" Value="{x:Static plugin:PluginState.Running}">
                                                    <Setter Property="ToolTip" Value="运行中"/>
                                                </DataTrigger>

                                                <DataTrigger Binding="{Binding State}" Value="{x:Static plugin:PluginState.Stopping}">
                                                    <Setter Property="ToolTip" Value="停止中"/>
                                                </DataTrigger>

                                                <DataTrigger Binding="{Binding State}" Value="{x:Static plugin:PluginState.Stopped}">
                                                    <Setter Property="ToolTip" Value="已停止"/>
                                                </DataTrigger>

                                                <DataTrigger Binding="{Binding State}" Value="{x:Static plugin:PluginState.Faulted}">
                                                    <Setter Property="ToolTip" Value="{Binding Exception}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </material:ColorZone.Resources>

                                    <material:PackIcon Width="20"
                                                       Height="20"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center">
                                        <material:PackIcon.Resources>
                                            <Style TargetType="material:PackIcon">
                                                <Setter Property="Kind" Value="PowerSleep"/>

                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding State}" Value="{x:Static plugin:PluginState.Compiling}">
                                                        <Setter Property="Kind" Value="Wrench"/>
                                                    </DataTrigger>

                                                    <DataTrigger Binding="{Binding State}" Value="{x:Static plugin:PluginState.Running}">
                                                        <Setter Property="Kind" Value="Play"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource MaterialDesignSuccessBrush}"/>
                                                    </DataTrigger>

                                                    <DataTrigger Binding="{Binding State}" Value="{x:Static plugin:PluginState.Stopping}">
                                                        <Setter Property="Kind" Value="Stop"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource MaterialDesignWarningBrush}"/>
                                                    </DataTrigger>

                                                    <DataTrigger Binding="{Binding State}" Value="{x:Static plugin:PluginState.Stopped}">
                                                        <Setter Property="Kind" Value="Stop"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource MaterialDesignErrorBrush}"/>
                                                    </DataTrigger>

                                                    <DataTrigger Binding="{Binding State}" Value="{x:Static plugin:PluginState.Faulted}">
                                                        <Setter Property="Kind" Value="ExclamationBold"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource MaterialDesignErrorBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </material:PackIcon.Resources>
                                    </material:PackIcon>
                                </material:ColorZone>

                                <TextBlock DockPanel.Dock="Left"
                                           Margin="10 0 0 0"
                                           VerticalAlignment="Center"
                                           Text="{Binding File.Name}"/>

                                <Button s:View.ActionTarget="{Binding}"
                                        DockPanel.Dock="Right"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Width="30"
                                        Height="30"
                                        Padding="0"
                                        material:ButtonAssist.CornerRadius="0"
                                        Click="{s:Action QueueCompile}"
                                        IsEnabled="{Binding CanCompile}"
                                        ToolTip="编译">
                                    <material:PackIcon Kind="Replay"/>
                                </Button>
                            </DockPanel>
                        </material:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
