<UserControl x:Class="MultiFunPlayer.UI.Controls.Views.GeneralSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:MultiFunPlayer.UI"
             xmlns:vm="clr-namespace:MultiFunPlayer.UI.Controls.ViewModels"
             d:DesignHeight="450"
             d:DesignWidth="800"
             x:ClassModifier="internal"
             mc:Ignorable="d">
    <Grid Margin="20">
        <DockPanel LastChildFill="True">
            <DockPanel DockPanel.Dock="Top" LastChildFill="False">
                <TextBlock DockPanel.Dock="Left"
                           Margin="0 0 10 0"
                           VerticalAlignment="Center"
                           Text="窗口置顶："/>

                <CheckBox DockPanel.Dock="Left"
                          Margin="0 0 10 0"
                          IsChecked="{Binding AlwaysOnTop}"/>
            </DockPanel>

            <DockPanel DockPanel.Dock="Top" LastChildFill="False">
                <TextBlock DockPanel.Dock="Left"
                           Margin="0 0 10 0"
                           VerticalAlignment="Center"
                           Text="允许调整窗口大小："/>

                <CheckBox DockPanel.Dock="Left"
                          Margin="0 0 10 0"
                          IsChecked="{Binding AllowWindowResize}"/>
            </DockPanel>

            <DockPanel DockPanel.Dock="Top" LastChildFill="False">
                <TextBlock DockPanel.Dock="Left"
                           Margin="0 0 10 0"
                           VerticalAlignment="Center"
                           Text="记住窗口位置："/>

                <CheckBox DockPanel.Dock="Left"
                          Margin="0 0 10 0"
                          IsChecked="{Binding RememberWindowLocation}"/>
            </DockPanel>

            <DockPanel DockPanel.Dock="Top" LastChildFill="False">
                <TextBlock DockPanel.Dock="Left"
                           Margin="0 0 10 0"
                           VerticalAlignment="Center"
                           Text="窗口布局："/>

                <ComboBox DockPanel.Dock="Left"
                          ItemsSource="{Binding Source={ui:EnumBindingSource {x:Type Orientation}}}"
                          SelectedItem="{Binding AppOrientation}"/>
            </DockPanel>

            <DockPanel DockPanel.Dock="Top" LastChildFill="False">
                <TextBlock DockPanel.Dock="Left"
                           Margin="0 0 10 0"
                           VerticalAlignment="Center"
                           Text="错误显示方式："/>

                <ComboBox DockPanel.Dock="Left"
                          ItemsSource="{Binding Source={ui:EnumBindingSource {x:Type vm:ErrorDisplayType}}}"
                          SelectedItem="{Binding ErrorDisplayType}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource DescriptionConverter}}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </DockPanel>

            <DockPanel DockPanel.Dock="Top" LastChildFill="False">
                <TextBlock DockPanel.Dock="Left"
                           Margin="0 0 10 0"
                           VerticalAlignment="Center"
                           Text="日志级别："/>

                <ComboBox DockPanel.Dock="Left"
                          ItemsSource="{Binding LogLevels}"
                          SelectedItem="{Binding LogLevel}"
                          Width="100"/>
            </DockPanel>

            <DockPanel DockPanel.Dock="Top" LastChildFill="False">
                <TextBlock DockPanel.Dock="Left"
                           Margin="0 0 10 0"
                           VerticalAlignment="Center"
                           Text="启用界面日志："/>

                <CheckBox DockPanel.Dock="Left"
                          Margin="0 0 10 0"
                          IsChecked="{Binding EnableUILogging}"/>
            </DockPanel>

            <DockPanel DockPanel.Dock="Top" LastChildFill="False">
                <TextBlock DockPanel.Dock="Left"
                           Margin="0 0 10 0"
                           VerticalAlignment="Center"
                           Text="启用 JSON 日志："/>

                <CheckBox DockPanel.Dock="Left"
                          Margin="0 0 10 0"
                          IsChecked="{Binding EnableJsonLogging}"/>
            </DockPanel>
        </DockPanel>
    </Grid>
</UserControl>
