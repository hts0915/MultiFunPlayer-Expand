<UserControl x:Class="MultiFunPlayer.UI.Controls.Views.ScriptView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviours="clr-namespace:MultiFunPlayer.UI.Behaviours"
             xmlns:common="clr-namespace:MultiFunPlayer.Common"
             xmlns:controls="clr-namespace:MultiFunPlayer.UI.Controls"
             xmlns:converters="clr-namespace:MultiFunPlayer.UI.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:material="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:metro="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:s="https://github.com/canton7/Stylet"
             xmlns:ui="clr-namespace:MultiFunPlayer.UI"
             xmlns:vm="clr-namespace:MultiFunPlayer.UI.Controls.ViewModels"
             d:DesignHeight="450"
             d:DesignWidth="800"
             x:ClassModifier="internal"
             mc:Ignorable="d">
    <UserControl.Resources>
        <converters:DoubleToPercentConverter x:Key="DoubleToPercentConverter"/>
        <converters:MotionProviderSelectorConverter x:Key="MotionProviderSelectorConverter"/>
        <converters:MotionProviderOverridesScriptConverter x:Key="MotionProviderOverridesScriptConverter"/>
        <converters:InvertValueConverter x:Key="InvertValueConverter"/>
        <material:MathConverter x:Key="PowMathConverter" Operation="Pow"/>
    </UserControl.Resources>
    <StackPanel Margin="0 0 0 20">
        <material:Card Margin="0 0 0 10" material:ShadowAssist.ShadowDepth="Depth1">
            <Expander Style="{StaticResource MaterialDesignToolBarExpander}"
                      material:ExpanderAssist.HorizontalHeaderPadding="0 0 6 0"
                      Background="{DynamicResource MaterialDesignToolBarBackground}"
                      IsExpanded="{Binding MediaContentVisible}">
                <Expander.Header>
                    <DockPanel Height="36" LastChildFill="True">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Width="36"
                                    Height="36"
                                    Padding="0"
                                    Click="{s:Action OnPlayPauseClick}">
                                <Button.Style>
                                    <Style BasedOn="{StaticResource MaterialDesignToolBarButton}" TargetType="{x:Type Button}">
                                        <Setter Property="ToolTip" Value="播放"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                <Setter Property="ToolTip" Value="暂停"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>

                                <material:PackIcon Width="28"
                                                   Height="28"
                                                   VerticalAlignment="Center">
                                    <material:PackIcon.Style>
                                        <Style TargetType="material:PackIcon">
                                            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignSuccessBrush}"/>
                                            <Setter Property="Kind" Value="Play"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource MaterialDesignErrorBrush}"/>
                                                    <Setter Property="Kind" Value="Pause"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </material:PackIcon.Style>
                                </material:PackIcon>
                            </Button>

                            <material:PopupBox Style="{StaticResource MaterialDesignToolBarPopupBox}"
                                               PlacementMode="BottomAndAlignRightEdges"
                                               StaysOpen="True"
                                               ToolTip="同步设置">
                                <material:PopupBox.ToggleContent>
                                    <Grid Width="24" Height="24">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="24"/>
                                            <RowDefinition Height="24"/>
                                        </Grid.RowDefinitions>

                                        <material:PackIcon Grid.Row="0"
                                                           Width="16"
                                                           Height="16"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Kind="FastForward">
                                            <material:PackIcon.Style>
                                                <Style TargetType="material:PackIcon">
                                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryHueMidBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSyncing}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignErrorBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </material:PackIcon.Style>
                                        </material:PackIcon>
                                        <ProgressBar Grid.Row="1"
                                                     Width="24"
                                                     Height="24"
                                                     Margin="0 -24 0 24"
                                                     VerticalAlignment="Center"
                                                     Value="{Binding SyncProgress, Mode=OneWay}">
                                            <ProgressBar.Style>
                                                <Style BasedOn="{StaticResource MaterialDesignCircularProgressBar}" TargetType="ProgressBar">
                                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryHueMidBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSyncing}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignErrorBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ProgressBar.Style>
                                        </ProgressBar>
                                    </Grid>
                                </material:PopupBox.ToggleContent>

                                <Grid Width="250" Margin="10">
                                    <StackPanel Orientation="Vertical">
                                        <DockPanel LastChildFill="True">
                                            <TextBlock DockPanel.Dock="Left"
                                                       Margin="0 0 10 0"
                                                       VerticalAlignment="Center"
                                                       Text="时长："/>
                                            <TextBlock DockPanel.Dock="Right"
                                                       Margin="10 0 0 0"
                                                       VerticalAlignment="Center"
                                                       Text="{Binding SyncSettings.Duration, StringFormat={}{0:F2}s}"/>
                                            <Slider DockPanel.Dock="Right"
                                                    VerticalAlignment="Center"
                                                    material:SliderAssist.OnlyShowFocusVisualWhileDragging="True"
                                                    IsSnapToTickEnabled="True"
                                                    Maximum="8"
                                                    Minimum="0.5"
                                                    TickFrequency="0.5"
                                                    Value="{Binding SyncSettings.Duration}"/>
                                        </DockPanel>

                                        <DockPanel Margin="0 10 0 0" LastChildFill="False">
                                            <TextBlock DockPanel.Dock="Left"
                                                       Margin="0 0 5 0"
                                                       HorizontalAlignment="Left"
                                                       VerticalAlignment="Center"
                                                       FontWeight="Bold"
                                                       Text="同步于："
                                                       Typography.Capitals="AllSmallCaps"/>
                                            <material:ColorZone DockPanel.Dock="Left"
                                                                Width="14"
                                                                Height="14"
                                                                VerticalAlignment="Center"
                                                                Background="{DynamicResource MaterialDesignWarningBrush}"
                                                                CornerRadius="7"
                                                                Mode="Custom">
                                                <material:ColorZone.ToolTip>
                                                    <TextBlock>
                                                        同步功能用于防止突然出现的意外运动。<LineBreak/>
                                                        这些设置仅供高级用法使用。</TextBlock>
                                                </material:ColorZone.ToolTip>
                                                <material:PackIcon Width="10"
                                                                   Height="10"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="Black"
                                                                   Kind="ExclamationBold"/>
                                            </material:ColorZone>
                                        </DockPanel>
                                        <DockPanel Margin="0 2 0 0" LastChildFill="False">
                                            <TextBlock DockPanel.Dock="Left" Text="媒体资源变化："/>
                                            <ToggleButton DockPanel.Dock="Right" IsChecked="{Binding SyncSettings.SyncOnMediaResourceChanged}"/>
                                        </DockPanel>

                                        <DockPanel Margin="0 2 0 0" LastChildFill="False">
                                            <TextBlock DockPanel.Dock="Left" Text="脚本资源变化："/>
                                            <ToggleButton DockPanel.Dock="Right" IsChecked="{Binding SyncSettings.SyncOnScriptResourceChanged}"/>
                                        </DockPanel>

                                        <DockPanel Margin="0 2 0 0" LastChildFill="False">
                                            <TextBlock DockPanel.Dock="Left" Text="脚本开始："/>
                                            <ToggleButton DockPanel.Dock="Right" IsChecked="{Binding SyncSettings.SyncOnScriptStart}"/>
                                        </DockPanel>

                                        <DockPanel Margin="0 2 0 0" LastChildFill="False">
                                            <TextBlock DockPanel.Dock="Left" Text="脚本结束："/>
                                            <ToggleButton DockPanel.Dock="Right" IsChecked="{Binding SyncSettings.SyncOnScriptEnd}"/>
                                        </DockPanel>

                                        <DockPanel Margin="0 2 0 0" LastChildFill="False">
                                            <TextBlock DockPanel.Dock="Left" Text="媒体播放/暂停："/>
                                            <ToggleButton DockPanel.Dock="Right" IsChecked="{Binding SyncSettings.SyncOnMediaPlayPause}"/>
                                        </DockPanel>

                                        <DockPanel Margin="0 2 0 0" LastChildFill="False">
                                            <TextBlock DockPanel.Dock="Left" Text="媒体跳转："/>
                                            <ToggleButton DockPanel.Dock="Right" IsChecked="{Binding SyncSettings.SyncOnSeek}"/>
                                        </DockPanel>

                                        <DockPanel Margin="0 2 0 0" LastChildFill="False">
                                            <TextBlock DockPanel.Dock="Left" Text="自动归位开始/结束："/>
                                            <ToggleButton DockPanel.Dock="Right" IsChecked="{Binding SyncSettings.SyncOnAutoHomeStartEnd}"/>
                                        </DockPanel>
                                    </StackPanel>
                                </Grid>
                            </material:PopupBox>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                            <Button Style="{StaticResource MaterialDesignToolBarButton}"
                                    Padding="8"
                                    Click="{s:Action OnOpenMediaLocation}"
                                    IsEnabled="{Binding MediaResource, Converter={StaticResource InvertedNullableToBooleanConverter}}"
                                    ToolTip="打开媒体所在位置">
                                <material:PackIcon Width="19"
                                                   Height="19"
                                                   Kind="FolderOpen"/>
                            </Button>

                            <Button Style="{StaticResource MaterialDesignToolBarButton}"
                                    Padding="8"
                                    Click="{s:Action OnOpenScriptRepositoryManagerDialog}"
                                    ToolTip="脚本仓库">
                                <material:PackIcon Width="19"
                                                   Height="19"
                                                   Kind="DatabaseSearch"/>
                            </Button>

                            <Button Style="{StaticResource MaterialDesignToolBarButton}"
                                    Padding="8"
                                    Click="{s:Action OnOpenMediaPathModifiersDialog}"
                                    ToolTip="媒体路径修改器">
                                <material:PackIcon Width="19"
                                                   Height="19"
                                                   Kind="FileReplaceOutline"/>
                            </Button>

                            <Button Style="{StaticResource MaterialDesignToolBarButton}"
                                    Padding="8"
                                    Click="{s:Action OnMapCurrentMediaPathToFile}"
                                    ToolTip="把媒体路径映射到文件">

                                <Button.IsEnabled>
                                    <MultiBinding Converter="{StaticResource BooleanAllConverter}">
                                        <MultiBinding.Bindings>
                                            <Binding Converter="{StaticResource InvertedNullableToBooleanConverter}" Path="MediaResource"/>
                                            <Binding Path="MediaResource.IsUrl"/>
                                        </MultiBinding.Bindings>
                                    </MultiBinding>
                                </Button.IsEnabled>
                                <material:PackIcon Width="19"
                                                   Height="19"
                                                   Kind="LinkPlus"/>
                            </Button>

                            <material:PopupBox DockPanel.Dock="Left"
                                               Style="{StaticResource MaterialDesignToolBarPopupBox}"
                                               StaysOpen="True"
                                               ToolTip="自动跳过">
                                <material:PopupBox.ToggleContent>
                                    <material:PackIcon Width="22"
                                                       Height="22"
                                                       Kind="SkipForward"/>
                                </material:PopupBox.ToggleContent>
                                <Grid Width="175" Margin="10">
                                    <StackPanel>
                                        <StackPanel Margin="0 0 0 10" Orientation="Horizontal">
                                            <TextBlock Width="50"
                                                       Margin="0 0 5 0"
                                                       VerticalAlignment="Center"
                                                       Text="已启用："/>

                                            <CheckBox Style="{StaticResource MaterialDesignSwitchToggleButton}" IsChecked="{Binding AutoSkipToScriptStartEnabled}"/>
                                        </StackPanel>

                                        <DockPanel Margin="0 0 0 10">
                                            <TextBlock DockPanel.Dock="Left"
                                                       Width="50"
                                                       Margin="0 0 5 0"
                                                       VerticalAlignment="Center"
                                                       Text="偏移："/>

                                            <metro:NumericUpDown DockPanel.Dock="Left"
                                                                 VerticalAlignment="Center"
                                                                 Interval="0.1"
                                                                 Maximum="0"
                                                                 SnapToMultipleOfInterval="True"
                                                                 StringFormat="{}{0:F1}s"
                                                                 Value="{Binding AutoSkipToScriptStartOffset}"/>
                                        </DockPanel>
                                    </StackPanel>
                                </Grid>
                            </material:PopupBox>

                            <Menu Background="{DynamicResource MaterialDesignPaper}">
                                <MenuItem Style="{StaticResource MaterialDesignToolBarMenuItem}" ToolTip="媒体循环">
                                    <MenuItem.Icon>
                                        <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="14"
                                                   FontWeight="Bold"
                                                   Text="AB">
                                            <TextBlock.Resources>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Value="True">
                                                            <DataTrigger.Binding>
                                                                <MultiBinding Converter="{StaticResource BooleanAllConverter}">
                                                                    <Binding Converter="{StaticResource InvertedNullableToBooleanConverter}" Path="MediaLoopSegment.StartPosition"/>
                                                                    <Binding Converter="{StaticResource InvertedNullableToBooleanConverter}" Path="MediaLoopSegment.EndPosition"/>
                                                                </MultiBinding>
                                                            </DataTrigger.Binding>
                                                            <DataTrigger.Setters>
                                                                <Setter Property="Foreground" Value="{DynamicResource MaterialDesignSuccessBrush}"/>
                                                            </DataTrigger.Setters>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Resources>
                                        </TextBlock>
                                    </MenuItem.Icon>

                                    <MenuItem Command="{s:Action ClearMediaLoop}"
                                              Header="清除"
                                              Icon="{material:PackIcon Kind=WindowClose}">
                                        <MenuItem.IsEnabled>
                                            <MultiBinding Converter="{StaticResource BooleanOrConverter}">
                                                <Binding Converter="{StaticResource InvertedNullableToBooleanConverter}" Path="MediaLoopSegment.StartPosition"/>
                                                <Binding Converter="{StaticResource InvertedNullableToBooleanConverter}" Path="MediaLoopSegment.EndPosition"/>
                                            </MultiBinding>
                                        </MenuItem.IsEnabled>
                                    </MenuItem>

                                    <MenuItem Command="{s:Action SetMediaLoopStartFromMediaPosition}"
                                              Header="设为起点"
                                              Icon="{material:PackIcon Kind=ContainStart}"/>

                                    <MenuItem Command="{s:Action SetMediaLoopEndFromMediaPosition}"
                                              Header="设为终点"
                                              Icon="{material:PackIcon Kind=ContainEnd}"/>

                                    <MenuItem Command="{s:Action SetMediaLoopFromCurrentChapter}"
                                              Header="重复章节"
                                              Icon="{material:PackIcon Kind=Contain}"/>
                                </MenuItem>
                            </Menu>
                        </StackPanel>
                    </DockPanel>
                </Expander.Header>

                <StackPanel Margin="20 15 20 15">
                    <DockPanel Margin="0 0 0 10" LastChildFill="True">
                        <TextBlock DockPanel.Dock="Left"
                                   Margin="0 0 10 0"
                                   VerticalAlignment="Center"
                                   Text="文件："/>

                        <TextBox DockPanel.Dock="Left"
                                 Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                 Margin="5 -10 0 0"
                                 VerticalAlignment="Center"
                                 material:HintAssist.Hint="{Binding MediaResource.Source}"
                                 IsReadOnly="True"
                                 Text="{Binding MediaResource.Name, Mode=OneWay}"/>
                    </DockPanel>
                    <DockPanel LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left"
                                   Margin="0 0 10 0"
                                   VerticalAlignment="Center"
                                   Text="偏移："/>

                        <metro:NumericUpDown DockPanel.Dock="Left"
                                             Width="100"
                                             Interval="0.1"
                                             StringFormat="{}{0:F2}s"
                                             TrackMouseWheelWhenMouseOver="True"
                                             ValueChanged="{s:Action OnOffsetValueChanged}"
                                             Value="{Binding GlobalOffset}"/>
                    </DockPanel>
                </StackPanel>
            </Expander>
        </material:Card>

        <controls:KeyframesHeatmap Height="36"
                                   Margin="0 0 0 4"
                                   Panel.ZIndex="-1"
                                   BucketCount="{Binding HeatmapBucketCount}"
                                   CombineHeat="{Binding HeatmapCombineHeat}"
                                   Cursor="Hand"
                                   EnablePreview="{Binding HeatmapEnablePreview}"
                                   InvertY="{Binding HeatmapInvertY}"
                                   Keyframes="{Binding AxisKeyframes, Mode=OneWay}"
                                   Position="{Binding MediaPosition, Mode=OneWay}"
                                   SeekRequest="{s:Action OnSeekRequest}"
                                   Settings="{Binding AxisSettings, Mode=OneWay}"
                                   ShowRange="{Binding HeatmapShowRange}"
                                   Duration="{Binding MediaDuration, Mode=OneWay}">
            <!-- 与预设区的时间轴一致：暂停/未播放时置灰，播放中恢复 -->
            <controls:KeyframesHeatmap.Style>
                <Style TargetType="{x:Type controls:KeyframesHeatmap}">
                    <Setter Property="Opacity" Value="0.35"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                            <Setter Property="Opacity" Value="1.0"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </controls:KeyframesHeatmap.Style>
            <controls:KeyframesHeatmap.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="显示脚本范围"
                              IsCheckable="True"
                              IsChecked="{Binding HeatmapShowRange}"/>

                    <MenuItem Header="启用脚本预览"
                              IsCheckable="True"
                              IsChecked="{Binding HeatmapEnablePreview}"/>

                    <MenuItem Header="合并脚本热度"
                              IsCheckable="True"
                              IsChecked="{Binding HeatmapCombineHeat}"/>

                    <MenuItem Header="Y 轴反向"
                              IsCheckable="True"
                              IsChecked="{Binding HeatmapInvertY}"/>

                    <Separator/>

                    <MenuItem Header="质量" IsEnabled="False"/>
                    <MenuItem material:RippleAssist.IsDisabled="True">
                        <MenuItem.Icon>
                            <TextBlock Padding="0"
                                       FontSize="10"
                                       Text="{Binding HeatmapBucketCount}"/>
                        </MenuItem.Icon>
                        <MenuItem.HeaderTemplate>
                            <DataTemplate>
                                <Slider material:SliderAssist.OnlyShowFocusVisualWhileDragging="True"
                                        Maximum="{Binding Source={x:Static controls:KeyframesHeatmap.MaxBucketCount}}"
                                        Minimum="100"
                                        Value="{Binding PlacementTarget.DataContext.HeatmapBucketCount, RelativeSource={RelativeSource FindAncestor, AncestorType=ContextMenu}}"/>
                            </DataTemplate>
                        </MenuItem.HeaderTemplate>
                    </MenuItem>

                    <Separator/>
                </ContextMenu>
            </controls:KeyframesHeatmap.ContextMenu>
        </controls:KeyframesHeatmap>

        <controls:MarkersPreview Height="18"
                                 Margin="0 0 0 20"
                                 Panel.ZIndex="-1"
                                 Bookmarks="{Binding AxisBookmarks, Mode=OneWay}"
                                 Chapters="{Binding AxisChapters, Mode=OneWay}"
                                 Position="{Binding MediaPosition, Mode=OneWay}"
                                 SeekRequest="{s:Action OnSeekRequest}"
                                 Duration="{Binding MediaDuration, Mode=OneWay}"/>
        <material:Card Margin="0 0 0 10" material:ShadowAssist.ShadowDepth="Depth1">
            <controls:NonReloadingTabControl ItemsSource="{Binding AxisModels}">
                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Width="46" Height="36">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Text="{Binding Key}">
                                <TextBlock.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBodyDisabledBrush}"/>
                                        <Setter Property="FontWeight" Value="Medium"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Value.Script, Converter={StaticResource InvertedNullableToBooleanConverter}}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource InvertedPrimaryHueDarkBrush}"/>
                                                <Setter Property="FontWeight" Value="Black"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Value.Settings.BypassScript}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource MaterialDesignErrorBrush}"/>
                                                <Setter Property="FontWeight" Value="Black"/>
                                            </DataTrigger>
                                            <DataTrigger Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource MaterialDesignErrorBrush}"/>
                                                <Setter Property="FontWeight" Value="Black"/>
                                                <DataTrigger.Binding>
                                                    <MultiBinding Converter="{StaticResource BooleanAndConverter}">
                                                        <Binding Path="Value.Settings.LockScript"/>
                                                        <Binding Converter="{StaticResource InvertedNullableToBooleanConverter}" Path="Value.Script"/>
                                                    </MultiBinding>
                                                </DataTrigger.Binding>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Resources>
                            </TextBlock>

                            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Bottom">
                                <Border Margin="8 0 8 0"
                                        Padding="0 0 0 4"
                                        Background="Transparent"
                                        ToolTipService.HorizontalOffset="8"
                                        ToolTipService.InitialShowDelay="750"
                                        ToolTipService.Placement="Right"
                                        ToolTipService.VerticalOffset="-42">
                                    <Border.ToolTip>
                                        <StackPanel Typography.Capitals="AllSmallCaps">
                                            <TextBlock FontSize="13">
                                                <Run FontWeight="Bold" Text="链接轴："/>
                                                <Run>
                                                    <Run.Resources>
                                                        <Style TargetType="{x:Type Run}">
                                                            <Setter Property="Text" Value="已禁用"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignPaper}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Value.Settings.LinkAxis, Converter={StaticResource InvertedNullableToBooleanConverter}}" Value="True">
                                                                    <Setter Property="Text" Value="已启用"/>
                                                                    <Setter Property="Foreground" Value="{DynamicResource MaterialDesignLightSuccessBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Value.Settings.LinkAxisHasPriority}" Value="True">
                                                                    <Setter Property="Text" Value="覆盖"/>
                                                                    <Setter Property="Foreground" Value="{DynamicResource MaterialDesignLightErrorBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Run.Resources>
                                                </Run>
                                            </TextBlock>

                                            <TextBlock Margin="0 -5 0 0" FontSize="13">
                                                <Run FontWeight="Bold" Text="运动生成器："/>
                                                <Run>
                                                    <Run.Resources>
                                                        <Style TargetType="{x:Type Run}">
                                                            <Setter Property="Text" Value="已禁用"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignPaper}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Value.Settings.SelectedMotionProvider, Converter={StaticResource InvertedNullableToBooleanConverter}}" Value="True">
                                                                    <Setter Property="Text" Value="已启用"/>
                                                                    <Setter Property="Foreground" Value="{DynamicResource MaterialDesignLightSuccessBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Value="True">
                                                                    <DataTrigger.Binding>
                                                                        <MultiBinding Converter="{StaticResource MotionProviderOverridesScriptConverter}">
                                                                            <Binding Path="Value.Script"/>
                                                                            <Binding Path="Value.Settings.SelectedMotionProvider"/>
                                                                            <Binding Path="Value.Settings.MotionProviderBlend"/>
                                                                        </MultiBinding>
                                                                    </DataTrigger.Binding>
                                                                    <Setter Property="Text" Value="覆盖"/>
                                                                    <Setter Property="Foreground" Value="{DynamicResource MaterialDesignLightErrorBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Value.Settings.BypassMotionProvider}" Value="True">
                                                                    <Setter Property="Text" Value="旁路"/>
                                                                    <Setter Property="Foreground" Value="{DynamicResource MaterialDesignPaper}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Run.Resources>
                                                </Run>
                                            </TextBlock>

                                            <TextBlock Margin="0 -5 0 0" FontSize="13">
                                                <Run FontWeight="Bold" Text="速度限制："/>
                                                <Run>
                                                    <Run.Resources>
                                                        <Style TargetType="{x:Type Run}">
                                                            <Setter Property="Text" Value="已禁用"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignPaper}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Value.Settings.SpeedLimitEnabled}" Value="True">
                                                                    <Setter Property="Text" Value="已启用"/>
                                                                    <Setter Property="Foreground" Value="{DynamicResource MaterialDesignLightSuccessBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Value.State.IsSpeedLimited}" Value="True">
                                                                    <Setter Property="Text" Value="已生效"/>
                                                                    <Setter Property="Foreground" Value="{DynamicResource MaterialDesignLightErrorBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Run.Resources>
                                                </Run>
                                            </TextBlock>

                                            <TextBlock Margin="0 -5 0 0" FontSize="13">
                                                <Run FontWeight="Bold" Text="智能限制："/>
                                                <Run>
                                                    <Run.Resources>
                                                        <Style TargetType="{x:Type Run}">
                                                            <Setter Property="Text" Value="已禁用"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignPaper}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Value.Settings.SmartLimitInputAxis, Converter={StaticResource InvertedNullableToBooleanConverter}}" Value="True">
                                                                    <Setter Property="Text" Value="已启用"/>
                                                                    <Setter Property="Foreground" Value="{DynamicResource MaterialDesignLightSuccessBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Value.State.IsSmartLimited}" Value="True">
                                                                    <Setter Property="Text" Value="已生效"/>
                                                                    <Setter Property="Foreground" Value="{DynamicResource MaterialDesignLightErrorBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Run.Resources>
                                                </Run>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border.ToolTip>

                                    <UniformGrid Columns="4">
                                        <material:PackIcon Width="6"
                                                           Height="6"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Kind="Circle">
                                            <material:PackIcon.Resources>
                                                <Style TargetType="material:PackIcon">
                                                    <Setter Property="Foreground" Value="{DynamicResource MaterialDesignDivider}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Value.Settings.LinkAxis, Converter={StaticResource InvertedNullableToBooleanConverter}}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignSuccessBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Value.Settings.LinkAxisHasPriority}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignErrorBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </material:PackIcon.Resources>
                                        </material:PackIcon>

                                        <material:PackIcon Width="6"
                                                           Height="6"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Kind="Circle">
                                            <material:PackIcon.Resources>
                                                <Style TargetType="material:PackIcon">
                                                    <Setter Property="Foreground" Value="{DynamicResource MaterialDesignDivider}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Value.Settings.SelectedMotionProvider, Converter={StaticResource InvertedNullableToBooleanConverter}}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignSuccessBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Value="True">
                                                            <DataTrigger.Binding>
                                                                <MultiBinding Converter="{StaticResource MotionProviderOverridesScriptConverter}">
                                                                    <Binding Path="Value.Script"/>
                                                                    <Binding Path="Value.Settings.SelectedMotionProvider"/>
                                                                    <Binding Path="Value.Settings.MotionProviderBlend"/>
                                                                </MultiBinding>
                                                            </DataTrigger.Binding>
                                                            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignErrorBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Value.Settings.BypassMotionProvider}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignDivider}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </material:PackIcon.Resources>
                                        </material:PackIcon>

                                        <material:PackIcon Width="6"
                                                           Height="6"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Kind="Circle">
                                            <material:PackIcon.Resources>
                                                <Style TargetType="material:PackIcon">
                                                    <Setter Property="Foreground" Value="{DynamicResource MaterialDesignDivider}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Value.Settings.SpeedLimitEnabled}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignSuccessBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Value.State.IsSpeedLimited}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignErrorBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </material:PackIcon.Resources>
                                        </material:PackIcon>

                                        <material:PackIcon Width="6"
                                                           Height="6"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Kind="Circle">
                                            <material:PackIcon.Resources>
                                                <Style TargetType="material:PackIcon">
                                                    <Setter Property="Foreground" Value="{DynamicResource MaterialDesignDivider}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Value.Settings.SmartLimitInputAxis, Converter={StaticResource InvertedNullableToBooleanConverter}}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignSuccessBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Value.State.IsSmartLimited}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignErrorBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </material:PackIcon.Resources>
                                        </material:PackIcon>
                                    </UniformGrid>
                                </Border>
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </TabControl.ItemTemplate>
                <TabControl.ContentTemplate>
                    <DataTemplate>
                        <DockPanel LastChildFill="True">
                            <Expander Style="{StaticResource MaterialDesignToolBarExpander}"
                                      material:ExpanderAssist.HorizontalHeaderPadding="0 0 6 0"
                                      Background="{DynamicResource MaterialDesignToolBarBackground}"
                                      IsExpanded="{Binding DataContext.AxisContentVisible, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}">
                                <Expander.Header>
                                    <DockPanel Height="36" LastChildFill="True">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <TextBlock Margin="0 0 10 0"
                                                       VerticalAlignment="Center"
                                                       FontSize="14"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                       Text="{Binding Key.FriendlyName}"
                                                       Typography.Capitals="AllSmallCaps"/>
                                        </StackPanel>
                                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                            <Menu Background="{DynamicResource MaterialDesignPaper}">
                                                <MenuItem Style="{StaticResource MaterialDesignToolBarMenuItem}" ToolTip="脚本">
                                                    <MenuItem.Icon>
                                                        <material:PackIcon Width="19"
                                                                           Height="19"
                                                                           Kind="File"/>
                                                    </MenuItem.Icon>

                                                    <MenuItem Command="{s:Action OnAxisOpenFolder}"
                                                              CommandParameter="{Binding Key}"
                                                              Header="打开文件夹"
                                                              Icon="{material:PackIcon Kind=FolderOpen}"
                                                              IsEnabled="{Binding Value.Script, Converter={StaticResource InvertedNullableToBooleanConverter}}"/>

                                                    <MenuItem Command="{s:Action OnAxisLoad}"
                                                              CommandParameter="{Binding Key}"
                                                              Header="加载"
                                                              Icon="{material:PackIcon Kind=FileDownload}"
                                                              IsEnabled="{Binding DataContext.MediaResource, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}, Converter={StaticResource InvertedNullableToBooleanConverter}}"/>

                                                    <MenuItem Command="{s:Action OnAxisClear}"
                                                              CommandParameter="{Binding Key}"
                                                              Header="清除"
                                                              Icon="{material:PackIcon Kind=Close}"
                                                              IsEnabled="{Binding Value.Script, Converter={StaticResource InvertedNullableToBooleanConverter}}"/>

                                                    <MenuItem Command="{s:Action OnAxisReload}"
                                                              CommandParameter="{Binding Key}"
                                                              Header="重新加载"
                                                              Icon="{material:PackIcon Kind=Reload}"
                                                              IsEnabled="{Binding DataContext.MediaResource, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}, Converter={StaticResource InvertedNullableToBooleanConverter}}"/>

                                                    <MenuItem Command="{s:Action OnAxisToggleLock}" CommandParameter="{Binding Key}">
                                                        <MenuItem.Resources>
                                                            <Style BasedOn="{StaticResource MaterialDesignMenuItem}" TargetType="{x:Type MenuItem}">
                                                                <Setter Property="Icon" Value="{material:PackIcon Kind=LockOpenVariantOutline}"/>
                                                                <Setter Property="Header" Value="锁定"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Value.Settings.LockScript}" Value="True">
                                                                        <DataTrigger.Setters>
                                                                            <Setter Property="Icon" Value="{material:PackIcon Kind=Lock}"/>
                                                                            <Setter Property="Header" Value="解锁"/>
                                                                            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignErrorBrush}"/>
                                                                        </DataTrigger.Setters>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </MenuItem.Resources>
                                                    </MenuItem>
                                                </MenuItem>
                                            </Menu>

                                            <ToggleButton Style="{StaticResource MaterialDesignToolBarToggleButton}"
                                                          Checked="{s:Action OnInvertScriptCheckedChanged}"
                                                          IsChecked="{Binding Value.Settings.InvertScript, Mode=OneWay}"
                                                          ToolTip="反转脚本"
                                                          Unchecked="{s:Action OnInvertScriptCheckedChanged}">
                                                <material:PackIcon Width="20"
                                                                   Height="20"
                                                                   Kind="FlipVertical"
                                                                   Opacity=".56"/>
                                                <material:ToggleButtonAssist.OnContent>
                                                    <material:PackIcon Width="20"
                                                                       Height="20"
                                                                       Foreground="{DynamicResource MaterialDesignSuccessBrush}"
                                                                       Kind="FlipVertical"/>
                                                </material:ToggleButtonAssist.OnContent>
                                            </ToggleButton>

                                            <material:PopupBox DockPanel.Dock="Left"
                                                               Style="{StaticResource MaterialDesignToolBarPopupBox}"
                                                               StaysOpen="True"
                                                               ToolTip="旁路">
                                                <material:PopupBox.ToggleContent>
                                                    <material:PackIcon Width="21"
                                                                       Height="21"
                                                                       Kind="MotionPauseOutline">
                                                        <material:PackIcon.Style>
                                                            <Style TargetType="material:PackIcon">
                                                                <Style.Triggers>
                                                                    <DataTrigger Value="True">
                                                                        <DataTrigger.Binding>
                                                                            <MultiBinding Converter="{StaticResource BooleanOrConverter}">
                                                                                <Binding Path="Value.Settings.BypassScript"/>
                                                                                <Binding Path="Value.Settings.BypassMotionProvider"/>
                                                                                <Binding Path="Value.Settings.BypassTransition"/>
                                                                            </MultiBinding>
                                                                        </DataTrigger.Binding>

                                                                        <Setter Property="Foreground" Value="{DynamicResource MaterialDesignErrorBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </material:PackIcon.Style>
                                                    </material:PackIcon>
                                                </material:PopupBox.ToggleContent>
                                                <Grid Margin="10">
                                                    <StackPanel>
                                                        <DockPanel Margin="0 0 0 15" LastChildFill="True">
                                                            <Button DockPanel.Dock="Right"
                                                                    Style="{StaticResource MaterialDesignPaperButton}"
                                                                    Width="32"
                                                                    Padding="0"
                                                                    Click="{s:Action OnBypassDisableAll}"
                                                                    ToolTip="全部禁用">
                                                                <Button.IsEnabled>
                                                                    <MultiBinding Converter="{StaticResource BooleanOrConverter}">
                                                                        <MultiBinding.Bindings>
                                                                            <Binding Path="Value.Settings.BypassScript"/>
                                                                            <Binding Path="Value.Settings.BypassMotionProvider"/>
                                                                            <Binding Path="Value.Settings.BypassTransition"/>
                                                                        </MultiBinding.Bindings>
                                                                    </MultiBinding>
                                                                </Button.IsEnabled>
                                                                <material:PackIcon Width="20"
                                                                                   Height="20"
                                                                                   Kind="ToggleSwitchOffOutline"/>
                                                            </Button>

                                                            <Button DockPanel.Dock="Left"
                                                                    Style="{StaticResource MaterialDesignPaperButton}"
                                                                    Margin="0 0 10 0"
                                                                    Click="{s:Action OnBypassEnableAll}"
                                                                    Content="全部旁路"
                                                                    Typography.Capitals="AllSmallCaps"/>
                                                        </DockPanel>

                                                        <TextBlock VerticalAlignment="Center"
                                                                   FontSize="12"
                                                                   FontWeight="Bold"
                                                                   Text="旁路："
                                                                   Typography.Capitals="AllSmallCaps"/>

                                                        <DockPanel Margin="0 0 0 5" LastChildFill="True">
                                                            <ToggleButton DockPanel.Dock="Right"
                                                                          Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                                                          IsChecked="{Binding Value.Settings.BypassScript}"/>
                                                            <TextBlock DockPanel.Dock="Left"
                                                                       VerticalAlignment="Center"
                                                                       Text="脚本："/>
                                                        </DockPanel>
                                                        <DockPanel Margin="0 0 0 5" LastChildFill="True">
                                                            <ToggleButton DockPanel.Dock="Right"
                                                                          Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                                                          IsChecked="{Binding Value.Settings.BypassMotionProvider}"/>
                                                            <TextBlock DockPanel.Dock="Left"
                                                                       Margin="0 0 10 0"
                                                                       VerticalAlignment="Center"
                                                                       Text="运动生成器："/>
                                                        </DockPanel>
                                                        <DockPanel LastChildFill="True">
                                                            <ToggleButton DockPanel.Dock="Right"
                                                                          Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                                                          IsChecked="{Binding Value.Settings.BypassTransition}"/>
                                                            <TextBlock DockPanel.Dock="Left"
                                                                       Margin="0 0 10 0"
                                                                       VerticalAlignment="Center"
                                                                       Text="自定义过渡："/>
                                                        </DockPanel>
                                                    </StackPanel>
                                                </Grid>
                                            </material:PopupBox>


                                            <material:PopupBox DockPanel.Dock="Left"
                                                               Style="{StaticResource MaterialDesignToolBarPopupBox}"
                                                               StaysOpen="True"
                                                               ToolTip="链接脚本">
                                                <material:PopupBox.ToggleContent>
                                                    <material:PackIcon Width="20"
                                                                       Height="20"
                                                                       Kind="LinkVariant">
                                                        <material:PackIcon.Style>
                                                            <Style TargetType="material:PackIcon">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Value.Settings.LinkAxis, Converter={StaticResource InvertedNullableToBooleanConverter}}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource MaterialDesignSuccessBrush}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Value.Settings.LinkAxisHasPriority}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource MaterialDesignSuccessBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </material:PackIcon.Style>
                                                    </material:PackIcon>
                                                </material:PopupBox.ToggleContent>
                                                <Grid Width="100" Margin="10">
                                                    <StackPanel>
                                                        <DockPanel LastChildFill="True">
                                                            <TextBlock DockPanel.Dock="Left"
                                                                       Margin="0 0 10 0"
                                                                       VerticalAlignment="Center"
                                                                       Text="目标："/>
                                                            <ComboBox DockPanel.Dock="Left"
                                                                      ItemsSource="{Binding Source={x:Static common:DeviceAxis.All}}"
                                                                      SelectedItem="{Binding Value.Settings.LinkAxis}"
                                                                      Width="50"
                                                                      Margin="0 0 10 0"
                                                                      material:TextFieldAssist.HasClearButton="True"
                                                                      SelectionChanged="{s:Action OnSelectedLinkAxisChanged}"/>
                                                        </DockPanel>
                                                        <DockPanel Margin="0 10 0 0" LastChildFill="False">
                                                            <CheckBox DockPanel.Dock="Left"
                                                                      Margin="0 0 5 0"
                                                                      Checked="{s:Action OnLinkAxisPriorityChanged}"
                                                                      Content="优先级"
                                                                      IsChecked="{Binding Value.Settings.LinkAxisHasPriority}"
                                                                      Unchecked="{s:Action OnLinkAxisPriorityChanged}"/>

                                                            <material:ColorZone DockPanel.Dock="Left"
                                                                                Width="14"
                                                                                Height="14"
                                                                                VerticalAlignment="Center"
                                                                                CornerRadius="7"
                                                                                Mode="PrimaryLight">
                                                                <material:ColorZone.ToolTip>
                                                                    <TextBlock>
                                                                        启用后，链接优先于自动加载的脚本</TextBlock>
                                                                </material:ColorZone.ToolTip>
                                                                <material:PackIcon Width="10"
                                                                                   Height="10"
                                                                                   HorizontalAlignment="Center"
                                                                                   VerticalAlignment="Center"
                                                                                   Kind="Help"/>
                                                            </material:ColorZone>
                                                        </DockPanel>
                                                    </StackPanel>
                                                </Grid>
                                            </material:PopupBox>

                                            <material:PopupBox DockPanel.Dock="Left"
                                                               Style="{StaticResource MaterialDesignToolBarPopupBox}"
                                                               StaysOpen="True"
                                                               ToolTip="运动">
                                                <material:PopupBox.ToggleContent>
                                                    <material:PackIcon Width="20"
                                                                       Height="20"
                                                                       Kind="Motion">
                                                        <material:PackIcon.Style>
                                                            <Style TargetType="material:PackIcon">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Value.Settings.SelectedMotionProvider, Converter={StaticResource InvertedNullableToBooleanConverter}}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource MaterialDesignSuccessBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </material:PackIcon.Style>
                                                    </material:PackIcon>
                                                </material:PopupBox.ToggleContent>
                                                <Grid Width="250" Margin="10 0 10 0">
                                                    <StackPanel>
                                                        <DockPanel LastChildFill="True">
                                                            <DockPanel DockPanel.Dock="Top"
                                                                       Margin="0 0 0 10"
                                                                       LastChildFill="True">
                                                                <TextBlock DockPanel.Dock="Left"
                                                                           Margin="0 0 10 0"
                                                                           VerticalAlignment="Center"
                                                                           Text="运动生成器："/>
                                                                <ComboBox DockPanel.Dock="Left"
                                                                          ItemsSource="{Binding DataContext.MotionProviderManager.MotionProviderNames, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
                                                                          behaviours:ComboBoxAssist.PreviewSelectionChanged="{s:Action OnPreviewSelectedMotionProviderChanged}"
                                                                          material:TextFieldAssist.HasClearButton="True"
                                                                          SelectedValue="{Binding Value.Settings.SelectedMotionProvider, UpdateSourceTrigger=Explicit}"/>
                                                            </DockPanel>

                                                            <material:Card DockPanel.Dock="Top" material:ShadowAssist.ShadowDepth="Depth1">
                                                                <Expander>
                                                                    <Expander.Header>
                                                                        <TextBlock Margin="12 0 0 0"
                                                                                   VerticalAlignment="Center"
                                                                                   FontSize="14"
                                                                                   FontWeight="Bold"
                                                                                   Text="常用设置"
                                                                                   Typography.Capitals="AllSmallCaps"/>
                                                                    </Expander.Header>

                                                                    <StackPanel Margin="10">
                                                                        <DockPanel DockPanel.Dock="Top">

                                                                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                                                                                <TextBlock Margin="0 0 5 0"
                                                                                           VerticalAlignment="Center"
                                                                                           FontSize="12"
                                                                                           FontWeight="Bold"
                                                                                           Text="混合数值"
                                                                                           Typography.Capitals="AllSmallCaps"/>

                                                                                <material:ColorZone DockPanel.Dock="Left"
                                                                                                    Width="14"
                                                                                                    Height="14"
                                                                                                    VerticalAlignment="Center"
                                                                                                    CornerRadius="7"
                                                                                                    Mode="PrimaryLight">
                                                                                    <material:ColorZone.ToolTip>
                                                                                        <TextBlock>
                                                                                            当此轴加载了脚本<LineBreak/>
                                                                                            且运动生成器正在运行时<LineBreak/>
                                                                                            输出值将是两者的混合结果<LineBreak/>
                                                                                            混合比例由下方滑块决定</TextBlock>
                                                                                    </material:ColorZone.ToolTip>
                                                                                    <material:PackIcon Width="10"
                                                                                                       Height="10"
                                                                                                       HorizontalAlignment="Center"
                                                                                                       VerticalAlignment="Center"
                                                                                                       Kind="Help"/>
                                                                                </material:ColorZone>
                                                                            </StackPanel>

                                                                            <Slider DockPanel.Dock="Top"
                                                                                    material:SliderAssist.OnlyShowFocusVisualWhileDragging="True"
                                                                                    IsSnapToTickEnabled="True"
                                                                                    Maximum="1"
                                                                                    Minimum="0"
                                                                                    SmallChange="0.01"
                                                                                    TickFrequency="0.01"
                                                                                    Value="{Binding Value.Settings.MotionProviderBlend}"/>

                                                                            <DockPanel DockPanel.Dock="Top" LastChildFill="False">
                                                                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                                                                    <TextBlock Margin="0 0 5 0"
                                                                                               VerticalAlignment="Center"
                                                                                               Text="脚本："
                                                                                               TextAlignment="Center"/>

                                                                                    <TextBlock VerticalAlignment="Center"
                                                                                               Text="{Binding Value.Settings.MotionProviderBlend, Converter={StaticResource InvertValueConverter}, ConverterParameter=1, StringFormat={}{0:P0}}"
                                                                                               TextAlignment="Center"/>
                                                                                </StackPanel>

                                                                                <StackPanel DockPanel.Dock="Right"
                                                                                            Width="90"
                                                                                            Orientation="Horizontal">
                                                                                    <TextBlock Margin="0 0 5 0"
                                                                                               VerticalAlignment="Center"
                                                                                               Text="提供者："
                                                                                               TextAlignment="Center"/>

                                                                                    <TextBlock VerticalAlignment="Center"
                                                                                               Text="{Binding Value.Settings.MotionProviderBlend, StringFormat={}{0:P0}}"
                                                                                               TextAlignment="Center"/>
                                                                                </StackPanel>
                                                                            </DockPanel>
                                                                        </DockPanel>

                                                                        <Separator/>

                                                                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                                                                            <TextBlock Margin="0 0 5 0"
                                                                                       VerticalAlignment="Center"
                                                                                       FontSize="12"
                                                                                       FontWeight="Bold"
                                                                                       Text="空隙填充"
                                                                                       Typography.Capitals="AllSmallCaps"/>

                                                                            <ToggleButton DockPanel.Dock="Right"
                                                                                          Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                                                                          Height="14"
                                                                                          VerticalAlignment="Center"
                                                                                          IsChecked="{Binding Value.Settings.MotionProviderFillGaps}"/>
                                                                        </StackPanel>

                                                                        <DockPanel LastChildFill="False">
                                                                            <DockPanel DockPanel.Dock="Left">
                                                                                <TextBlock DockPanel.Dock="Left"
                                                                                           VerticalAlignment="Center"
                                                                                           Text="至少填充"/>

                                                                                <metro:NumericUpDown DockPanel.Dock="Left"
                                                                                                     MinWidth="30"
                                                                                                     Margin="5 0 5 0"
                                                                                                     Interval="1"
                                                                                                     Minimum="0"
                                                                                                     StringFormat="{}{0:0}s"
                                                                                                     Value="{Binding Value.Settings.MotionProviderMinimumGapDuration}"/>

                                                                                <TextBlock DockPanel.Dock="Left"
                                                                                           VerticalAlignment="Center"
                                                                                           Text="{Binding Key.FriendlyName, StringFormat={}{0} 脚本空隙}"/>
                                                                            </DockPanel>
                                                                        </DockPanel>

                                                                        <Separator/>

                                                                        <DockPanel Margin="0 0 0 10"
                                                                                   LastChildFill="False"
                                                                                   Visibility="{Binding Value.Settings.UpdateMotionProviderWithAxis, Converter={StaticResource NullVisibilityConverter}}">
                                                                            <TextBlock DockPanel.Dock="Left"
                                                                                       VerticalAlignment="Center"
                                                                                       Text="{Binding Value.Settings.UpdateMotionProviderWithAxis, StringFormat={}匹配 {0} 的速度}"/>

                                                                            <ToggleButton DockPanel.Dock="Right"
                                                                                          Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                                                                          IsChecked="{Binding Value.Settings.MotionProviderSpeedLimitWithAxis}"/>
                                                                        </DockPanel>

                                                                        <TextBlock VerticalAlignment="Center"
                                                                                   FontSize="12"
                                                                                   FontWeight="Bold"
                                                                                   Text="更新时机…"
                                                                                   Typography.Capitals="AllSmallCaps"/>

                                                                        <StackPanel Margin="0 5 0 0">
                                                                            <DockPanel LastChildFill="False">
                                                                                <TextBlock DockPanel.Dock="Left"
                                                                                           VerticalAlignment="Center"
                                                                                           Text="媒体已暂停"/>

                                                                                <ToggleButton DockPanel.Dock="Right"
                                                                                              Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                                                                              IsChecked="{Binding Value.Settings.UpdateMotionProviderWhenPaused}"/>
                                                                            </DockPanel>

                                                                            <DockPanel LastChildFill="False">
                                                                                <TextBlock DockPanel.Dock="Left"
                                                                                           VerticalAlignment="Center"
                                                                                           Text="{Binding Key.FriendlyName, StringFormat={}{0} 轴没有脚本}"/>

                                                                                <ToggleButton DockPanel.Dock="Right"
                                                                                              Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                                                                              IsChecked="{Binding Value.Settings.UpdateMotionProviderWithoutScript}"/>
                                                                            </DockPanel>

                                                                            <DockPanel LastChildFill="False">
                                                                                <ComboBox DockPanel.Dock="Left"
                                                                                          ItemsSource="{Binding Source={x:Static common:DeviceAxis.All}}"
                                                                                          SelectedItem="{Binding Value.Settings.UpdateMotionProviderWithAxis}"
                                                                                          Width="50"
                                                                                          material:TextFieldAssist.HasClearButton="True"
                                                                                          SelectionChanged="{s:Action OnUpdateMotionProviderWithAxisChanged}"/>

                                                                                <TextBlock DockPanel.Dock="Left"
                                                                                           Margin="5 0 0 0"
                                                                                           VerticalAlignment="Center"
                                                                                           Text="正在运动"/>
                                                                            </DockPanel>
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                </Expander>
                                                            </material:Card>

                                                            <Separator DockPanel.Dock="Top" Margin="-10 0 -10 0"/>
                                                            <ContentControl DockPanel.Dock="Bottom">
                                                                <s:View.Model>
                                                                    <MultiBinding Converter="{StaticResource MotionProviderSelectorConverter}">
                                                                        <Binding Path="DataContext.MotionProviderManager" RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type UserControl}}"/>
                                                                        <Binding Path="Key"/>
                                                                        <Binding Path="Value.Settings.SelectedMotionProvider"/>
                                                                    </MultiBinding>
                                                                </s:View.Model>
                                                            </ContentControl>
                                                        </DockPanel>
                                                    </StackPanel>
                                                </Grid>
                                            </material:PopupBox>

                                            <material:PopupBox DockPanel.Dock="Left"
                                                               Style="{StaticResource MaterialDesignToolBarPopupBox}"
                                                               IsPopupOpen="False"
                                                               StaysOpen="True"
                                                               ToolTip="智能限制">
                                                <material:PopupBox.ToggleContent>
                                                    <material:PackIcon Width="18"
                                                                       Height="18"
                                                                       Kind="ChartSnakeyVariant">
                                                        <material:PackIcon.Style>
                                                            <Style TargetType="material:PackIcon">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Value.Settings.SmartLimitInputAxis, Converter={StaticResource InvertedNullableToBooleanConverter}}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource MaterialDesignSuccessBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </material:PackIcon.Style>
                                                    </material:PackIcon>
                                                </material:PopupBox.ToggleContent>

                                                <Grid Width="195" Margin="10">
                                                    <StackPanel>
                                                        <DockPanel LastChildFill="True">
                                                            <TextBlock DockPanel.Dock="Left"
                                                                       Margin="0 0 10 0"
                                                                       VerticalAlignment="Center"
                                                                       Text="输入轴："/>

                                                            <ComboBox DockPanel.Dock="Left"
                                                                      ItemsSource="{Binding Source={x:Static common:DeviceAxis.All}}"
                                                                      SelectedItem="{Binding Value.Settings.SmartLimitInputAxis}"
                                                                      material:TextFieldAssist.HasClearButton="True"
                                                                      SelectionChanged="{s:Action OnSelectedSmartLimitInputAxisChanged}"/>
                                                        </DockPanel>

                                                        <controls:SmartLimitPreview x:Name="SmartLimitPreview"
                                                                                    Margin="0 0 0 20"
                                                                                    HorizontalAlignment="Center"
                                                                                    Points="{Binding Value.Settings.SmartLimitPoints}">
                                                            <controls:SmartLimitPreview.Triggers>
                                                                <EventTrigger RoutedEvent="Loaded">
                                                                    <BeginStoryboard>
                                                                        <Storyboard RepeatBehavior="Forever">
                                                                            <DoubleAnimation BeginTime="0:0:0"
                                                                                             Storyboard.TargetProperty="Input"
                                                                                             From="0"
                                                                                             To="0"
                                                                                             Duration="0:0:0.500"/>
                                                                            <DoubleAnimation BeginTime="0:0:0.500"
                                                                                             Storyboard.TargetProperty="Input"
                                                                                             From="0"
                                                                                             To="100"
                                                                                             Duration="0:0:3"/>
                                                                            <DoubleAnimation BeginTime="0:0:3.500"
                                                                                             Storyboard.TargetProperty="Input"
                                                                                             From="100"
                                                                                             To="100"
                                                                                             Duration="0:0:0.500"/>
                                                                            <DoubleAnimation BeginTime="0:0:4"
                                                                                             Storyboard.TargetProperty="Input"
                                                                                             From="100"
                                                                                             To="0"
                                                                                             Duration="0:0:3"/>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </EventTrigger>
                                                            </controls:SmartLimitPreview.Triggers>
                                                        </controls:SmartLimitPreview>

                                                        <DockPanel LastChildFill="True">
                                                            <TextBlock DockPanel.Dock="Left"
                                                                       Margin="0 0 10 0"
                                                                       VerticalAlignment="Center"
                                                                       Text="模式："/>

                                                            <ComboBox DockPanel.Dock="Left"
                                                                      ItemsSource="{Binding Source={ui:EnumBindingSource {x:Type vm:SmartLimitMode}}}"
                                                                      SelectedItem="{Binding Value.Settings.SmartLimitMode}"
                                                                      material:TextFieldAssist.HasClearButton="True">
                                                                <ComboBox.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <TextBlock Text="{Binding Converter={StaticResource DescriptionConverter}}"/>
                                                                    </DataTemplate>
                                                                </ComboBox.ItemTemplate>
                                                            </ComboBox>
                                                        </DockPanel>

                                                        <DockPanel LastChildFill="True">
                                                            <DockPanel.Resources>
                                                                <Style TargetType="{x:Type DockPanel}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Value.Settings.SmartLimitMode}" Value="Value">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </DockPanel.Resources>

                                                            <TextBlock DockPanel.Dock="Left"
                                                                       Margin="0 0 10 0"
                                                                       VerticalAlignment="Center"
                                                                       Text="目标值："/>

                                                            <metro:NumericUpDown Interval="0.01"
                                                                                 Maximum="1"
                                                                                 Minimum="0"
                                                                                 StringFormat="P0"
                                                                                 Value="{Binding Value.Settings.SmartLimitTargetValue}"/>
                                                        </DockPanel>

                                                        <TextBlock Margin="0 10 0 0"
                                                                   VerticalAlignment="Center"
                                                                   FontSize="12"
                                                                   FontWeight="Bold"
                                                                   Text="当…"
                                                                   Typography.Capitals="AllSmallCaps"/>

                                                        <DockPanel>
                                                            <TextBlock DockPanel.Dock="Left"
                                                                       Margin="0 0 5 0"
                                                                       VerticalAlignment="Center"
                                                                       Text="{Binding Value.Settings.SmartLimitInputAxis}"/>

                                                            <TextBlock DockPanel.Dock="Left"
                                                                       Margin="0 0 5 0"
                                                                       VerticalAlignment="Center"
                                                                       Text="轴数值位于："/>

                                                            <TextBlock Text="{Binding Input, StringFormat={}{0:F0}%, ElementName=SmartLimitPreview}"/>
                                                        </DockPanel>

                                                        <TextBlock Margin="0 10 0 0"
                                                                   VerticalAlignment="Center"
                                                                   FontSize="12"
                                                                   FontWeight="Bold"
                                                                   Text="然后…"
                                                                   Typography.Capitals="AllSmallCaps"/>

                                                        <DockPanel>
                                                            <TextBlock DockPanel.Dock="Left"
                                                                       Margin="0 0 5 0"
                                                                       VerticalAlignment="Center"
                                                                       Text="限制"/>

                                                            <TextBlock DockPanel.Dock="Left"
                                                                       Margin="0 0 5 0"
                                                                       VerticalAlignment="Center"
                                                                       ToolTip="{Binding Key}"
                                                                       Text="{Binding Key.FriendlyName}"/>

                                                            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center">
                                                                <TextBlock.Resources>
                                                                    <Style BasedOn="{StaticResource MaterialDesignTextBlock}" TargetType="{x:Type TextBlock}">
                                                                        <Setter Property="Text" Value="轴速度至：  "/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Value.Settings.SmartLimitMode}" Value="Value">
                                                                                <Setter Property="Text" Value="轴范围至：  &#x00B1;"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Resources>
                                                            </TextBlock>

                                                            <TextBlock DockPanel.Dock="Left"
                                                                       VerticalAlignment="Center"
                                                                       Text="{Binding Output, StringFormat={}{0:F0}%, ElementName=SmartLimitPreview}"/>
                                                        </DockPanel>

                                                        <DockPanel>
                                                            <DockPanel.Resources>
                                                                <Style TargetType="{x:Type DockPanel}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Value.Settings.SmartLimitMode}" Value="Value">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </DockPanel.Resources>

                                                            <TextBlock DockPanel.Dock="Left"
                                                                       Margin="0 0 5 0"
                                                                       VerticalAlignment="Center"
                                                                       Text="偏离目标值"/>
                                                        </DockPanel>
                                                    </StackPanel>
                                                </Grid>
                                            </material:PopupBox>

                                            <material:PopupBox DockPanel.Dock="Left"
                                                               Style="{StaticResource MaterialDesignToolBarPopupBox}"
                                                               StaysOpen="True"
                                                               ToolTip="速度限制">
                                                <material:PopupBox.ToggleContent>
                                                    <material:PackIcon Width="22"
                                                                       Height="22"
                                                                       Kind="CarSpeedLimiter">
                                                        <material:PackIcon.Style>
                                                            <Style TargetType="material:PackIcon">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Value.Settings.SpeedLimitEnabled}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource MaterialDesignSuccessBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </material:PackIcon.Style>
                                                    </material:PackIcon>
                                                </material:PopupBox.ToggleContent>
                                                <Grid Margin="10">
                                                    <StackPanel Width="200">
                                                        <DockPanel Margin="0 0 0 10" LastChildFill="True">
                                                            <TextBlock DockPanel.Dock="Left"
                                                                       Width="50"
                                                                       Margin="0 0 10 0"
                                                                       VerticalAlignment="Center"
                                                                       Text="已启用："/>

                                                            <CheckBox DockPanel.Dock="Left"
                                                                      Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                                                      IsChecked="{Binding Value.Settings.SpeedLimitEnabled}"/>

                                                            <material:ColorZone DockPanel.Dock="Right"
                                                                                Width="14"
                                                                                Height="14"
                                                                                HorizontalAlignment="Right"
                                                                                VerticalAlignment="Center"
                                                                                CornerRadius="7"
                                                                                Mode="PrimaryLight">
                                                                <material:ColorZone.ToolTip>
                                                                    <TextBlock>
                                                                        1 单位 = 轴数值从 0% 到 100%（或反之）的变化量</TextBlock>
                                                                </material:ColorZone.ToolTip>
                                                                <material:PackIcon Width="10"
                                                                                   Height="10"
                                                                                   HorizontalAlignment="Center"
                                                                                   VerticalAlignment="Center"
                                                                                   Kind="Help"/>
                                                            </material:ColorZone>
                                                        </DockPanel>

                                                        <DockPanel LastChildFill="False">
                                                            <TextBlock DockPanel.Dock="Left"
                                                                       Margin="0 0 10 0"
                                                                       VerticalAlignment="Center"
                                                                       Text="限制： "/>

                                                            <metro:NumericUpDown DockPanel.Dock="Right"
                                                                                 Width="150"
                                                                                 Interval="0.1"
                                                                                 Minimum="0"
                                                                                 StringFormat="{}{0:F2} units/s"
                                                                                 Value="{Binding Value.Settings.SpeedLimitUnitsPerSecond}"/>
                                                        </DockPanel>

                                                        <DockPanel Margin="0 5 0 0" LastChildFill="True">
                                                            <TextBlock DockPanel.Dock="Left"
                                                                       VerticalAlignment="Center"
                                                                       Text="{Binding Value.Settings.SpeedLimitUnitsPerSecond, StringFormat={}{0:F3} s/unit, Converter={StaticResource PowMathConverter}, ConverterParameter=-1}"
                                                                       TextAlignment="Right"/>
                                                        </DockPanel>
                                                    </StackPanel>
                                                </Grid>
                                            </material:PopupBox>

                                            <material:PopupBox DockPanel.Dock="Left"
                                                               Style="{StaticResource MaterialDesignToolBarPopupBox}"
                                                               StaysOpen="True"
                                                               ToolTip="插值">
                                                <material:PopupBox.ToggleContent>
                                                    <material:PackIcon Width="20"
                                                                       Height="20"
                                                                       Kind="ChartBellCurve"/>
                                                </material:PopupBox.ToggleContent>
                                                <Grid Margin="10">
                                                    <StackPanel>
                                                        <controls:InterpolationPreview Width="160"
                                                                                       Height="80"
                                                                                       Margin="0 0 0 20"
                                                                                       InterpolationType="{Binding Value.Settings.InterpolationType}"/>

                                                        <DockPanel LastChildFill="True">
                                                            <TextBlock DockPanel.Dock="Left"
                                                                       Width="30"
                                                                       Margin="0 0 10 0"
                                                                       VerticalAlignment="Center"
                                                                       Text="类型："/>

                                                            <ComboBox DockPanel.Dock="Left"
                                                                      ItemsSource="{Binding Source={ui:EnumBindingSource {x:Type common:InterpolationType}}}"
                                                                      SelectedItem="{Binding Value.Settings.InterpolationType}">
                                                                <ComboBox.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <TextBlock Text="{Binding Converter={StaticResource DescriptionConverter}}"/>
                                                                    </DataTemplate>
                                                                </ComboBox.ItemTemplate>
                                                            </ComboBox>
                                                        </DockPanel>
                                                    </StackPanel>
                                                </Grid>
                                            </material:PopupBox>

                                            <material:PopupBox DockPanel.Dock="Left"
                                                               Style="{StaticResource MaterialDesignToolBarPopupBox}"
                                                               StaysOpen="True"
                                                               ToolTip="自动归位">
                                                <material:PopupBox.ToggleContent>
                                                    <material:PackIcon Width="22"
                                                                       Height="22"
                                                                       Kind="Home">
                                                        <material:PackIcon.Style>
                                                            <Style TargetType="material:PackIcon">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Value.Settings.AutoHomeEnabled}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource MaterialDesignSuccessBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </material:PackIcon.Style>
                                                    </material:PackIcon>
                                                </material:PopupBox.ToggleContent>
                                                <Grid Width="200" Margin="10">
                                                    <StackPanel>
                                                        <DockPanel Margin="0 0 0 10" LastChildFill="False">
                                                            <TextBlock DockPanel.Dock="Left"
                                                                       Margin="0 0 10 0"
                                                                       VerticalAlignment="Center"
                                                                       Text="已启用："/>

                                                            <CheckBox DockPanel.Dock="Left"
                                                                      Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                                                      IsChecked="{Binding Value.Settings.AutoHomeEnabled}"/>
                                                        </DockPanel>

                                                        <DockPanel Margin="0 0 0 10" LastChildFill="False">
                                                            <TextBlock DockPanel.Dock="Left"
                                                                       Margin="0 0 10 0"
                                                                       VerticalAlignment="Center"
                                                                       Text="脚本内自动归位："/>

                                                            <CheckBox DockPanel.Dock="Left"
                                                                      Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                                                      IsChecked="{Binding Value.Settings.AutoHomeInsideScript}"/>
                                                        </DockPanel>

                                                        <DockPanel>
                                                            <TextBlock DockPanel.Dock="Left"
                                                                       Margin="0 0 10 0"
                                                                       VerticalAlignment="Center"
                                                                       Text="延迟："/>

                                                            <metro:NumericUpDown Interval="0.5"
                                                                                 Minimum="0"
                                                                                 StringFormat="{}{0:0.00}s"
                                                                                 Value="{Binding Value.Settings.AutoHomeDelay}"/>
                                                        </DockPanel>

                                                        <DockPanel>
                                                            <TextBlock DockPanel.Dock="Left"
                                                                       Margin="0 0 10 0"
                                                                       VerticalAlignment="Center"
                                                                       Text="时长："/>

                                                            <metro:NumericUpDown Interval="0.5"
                                                                                 Minimum="0"
                                                                                 StringFormat="{}{0:0.00}s"
                                                                                 Value="{Binding Value.Settings.AutoHomeDuration}"/>
                                                        </DockPanel>

                                                        <DockPanel>
                                                            <TextBlock DockPanel.Dock="Left"
                                                                       Margin="0 0 10 0"
                                                                       VerticalAlignment="Center"
                                                                       Text="目标值："/>

                                                            <metro:NumericUpDown Interval="0.01"
                                                                                 Maximum="1"
                                                                                 Minimum="0"
                                                                                 StringFormat="P0"
                                                                                 Value="{Binding Value.Settings.AutoHomeTargetValue}"/>
                                                        </DockPanel>
                                                    </StackPanel>
                                                </Grid>
                                            </material:PopupBox>
                                        </StackPanel>
                                    </DockPanel>
                                </Expander.Header>

                                <StackPanel Margin="20 15 20 15">
                                    <DockPanel Margin="0 0 0 10" LastChildFill="True">
                                        <TextBlock DockPanel.Dock="Left"
                                                   Margin="0 0 10 0"
                                                   VerticalAlignment="Center"
                                                   Text="文件："/>

                                        <TextBox DockPanel.Dock="Right"
                                                 Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                                 Margin="0 -10 0 0"
                                                 VerticalAlignment="Center"
                                                 material:HintAssist.Hint="{Binding Value.Script.Source}"
                                                 Drop="{s:Action OnAxisDrop}"
                                                 IsReadOnly="True"
                                                 PreviewDragEnter="{s:Action OnPreviewDragOver}"
                                                 PreviewDragOver="{s:Action OnPreviewDragOver}"
                                                 Text="{Binding Value.Script.Name, Mode=OneWay}"
                                                 TextAlignment="Left"/>
                                    </DockPanel>
                                    <DockPanel>
                                        <DockPanel DockPanel.Dock="Left"
                                                   Margin="0 0 20 0"
                                                   LastChildFill="True">
                                            <TextBlock DockPanel.Dock="Left"
                                                       Margin="0 0 10 0"
                                                       VerticalAlignment="Center"
                                                       Text="偏移："/>

                                            <metro:NumericUpDown Width="100"
                                                                 Interval="0.1"
                                                                 StringFormat="{}{0:F2}s"
                                                                 TrackMouseWheelWhenMouseOver="True"
                                                                 ValueChanged="{s:Action OnOffsetValueChanged}"
                                                                 Value="{Binding Value.Settings.Offset}"/>
                                        </DockPanel>
                                        <DockPanel DockPanel.Dock="Left" LastChildFill="True">
                                            <TextBlock DockPanel.Dock="Left"
                                                       Margin="0 0 10 0"
                                                       VerticalAlignment="Center"
                                                       Text="缩放："/>
                                            <TextBlock DockPanel.Dock="Right"
                                                       Width="50"
                                                       VerticalAlignment="Center"
                                                       Text="{Binding Value.Settings.ScriptScale, StringFormat={}{0:P0}}"
                                                       TextAlignment="Right"/>

                                            <Slider DockPanel.Dock="Left"
                                                    behaviours:SliderAssist.DefaultValueOnDoubleClick="1"
                                                    material:SliderAssist.OnlyShowFocusVisualWhileDragging="True"
                                                    IsSnapToTickEnabled="True"
                                                    Maximum="4"
                                                    Minimum="0.01"
                                                    SmallChange="0.01"
                                                    TickFrequency="0.01"
                                                    ValueChanged="{s:Action OnScriptScaleSliderValueChanged}"
                                                    Value="{Binding Value.Settings.ScriptScale}"/>
                                        </DockPanel>
                                    </DockPanel>
                                </StackPanel>
                            </Expander>
                        </DockPanel>
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </controls:NonReloadingTabControl>
        </material:Card>

        <material:Card material:ShadowAssist.ShadowDepth="Depth1">
            <Expander Style="{StaticResource MaterialDesignToolBarExpander}"
                      material:ExpanderAssist.HorizontalHeaderPadding="24 6 6 6"
                      Background="{DynamicResource MaterialDesignToolBarBackground}"
                      IsExpanded="{Binding ValuesContentVisible}">
                <Expander.Header>
                    <TextBlock Margin="12 0 0 0"
                               VerticalAlignment="Center"
                               FontSize="14"
                               FontWeight="Bold"
                               Text="轴数值"
                               Typography.Capitals="AllSmallCaps"/>
                </Expander.Header>

                <StackPanel Margin="15 15 15 15">
                    <ItemsControl ItemsSource="{Binding AxisStates}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" IsItemsHost="True"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style>
                                <Setter Property="FrameworkElement.Margin" Value="5 0 5 0"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0" LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Left"
                                               Width="30"
                                               Margin="0 0 5 0"
                                               ToolTip="{Binding Key}"
                                               Text="{Binding Key.FriendlyName, Mode=OneWay}"/>
                                    <ProgressBar DockPanel.Dock="Right"
                                                 Width="140"
                                                 Height="10"
                                                 material:TransitionAssist.DisableTransitions="True"
                                                 Style="{StaticResource MaterialDesignLinearProgressBar}"
                                                 Maximum="100"
                                                 Minimum="0"
                                                 Value="{Binding Value.Value, Mode=OneWay, Converter={StaticResource DoubleToPercentConverter}}"/>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Expander>
        </material:Card>
    </StackPanel>
</UserControl>
