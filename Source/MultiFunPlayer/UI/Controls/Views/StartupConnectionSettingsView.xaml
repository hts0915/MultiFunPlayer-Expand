<UserControl x:Class="MultiFunPlayer.UI.Controls.Views.StartupConnectionSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:s="https://github.com/canton7/Stylet"
             xmlns:ui="clr-namespace:MultiFunPlayer.UI"
             xmlns:vm="clr-namespace:MultiFunPlayer.UI.Controls.ViewModels"
             d:DesignHeight="450"
             d:DesignWidth="800"
             x:ClassModifier="internal"
             mc:Ignorable="d">
    <Grid Margin="20">
        <StackPanel>
            <DockPanel Margin="0 0 0 8" LastChildFill="False">
                <TextBlock DockPanel.Dock="Left"
                           MinWidth="150"
                           VerticalAlignment="Center"
                           Text="启动时自动连接设备："/>

                <CheckBox DockPanel.Dock="Left"
                          VerticalAlignment="Center"
                          IsChecked="{Binding AutoConnectOnStartup}"/>
            </DockPanel>

            <DockPanel Margin="0 0 0 8" LastChildFill="False">
                <TextBlock DockPanel.Dock="Left"
                           MinWidth="150"
                           VerticalAlignment="Center"
                           Text="连接成功后提示："/>

                <CheckBox DockPanel.Dock="Left"
                          VerticalAlignment="Center"
                          IsChecked="{Binding ShowConnectNotification}"/>
            </DockPanel>

            <DockPanel Margin="0 0 0 8" LastChildFill="False">
                <TextBlock DockPanel.Dock="Left"
                           MinWidth="150"
                           VerticalAlignment="Center"
                           Text="数据线串口匹配："/>

                <TextBox DockPanel.Dock="Left"
                         Width="220"
                         VerticalAlignment="Center"
                         Text="{Binding UsbSerialMatch}"/>
            </DockPanel>

            <DockPanel Margin="0 0 0 8" LastChildFill="False">
                <TextBlock DockPanel.Dock="Left"
                           MinWidth="150"
                           VerticalAlignment="Center"
                           Text="蓝牙设备名匹配："/>

                <TextBox DockPanel.Dock="Left"
                         Width="220"
                         VerticalAlignment="Center"
                         Text="{Binding BluetoothDeviceMatch}"/>
            </DockPanel>

            <DockPanel Margin="0 0 0 8" LastChildFill="False">
                <TextBlock DockPanel.Dock="Left"
                           MinWidth="150"
                           VerticalAlignment="Center"
                           Text="WiFi 默认协议："/>

                <ComboBox DockPanel.Dock="Left"
                          MinWidth="80"
                          VerticalAlignment="Center"
                          ItemsSource="{Binding WifiProtocols}"
                          SelectedItem="{Binding DefaultWifiProtocol}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource DescriptionConverter}}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </DockPanel>

            <DockPanel Margin="0 0 0 12" LastChildFill="False">
                <TextBlock DockPanel.Dock="Left"
                           MinWidth="150"
                           VerticalAlignment="Center"
                           Text="WiFi 默认地址："/>

                <TextBox DockPanel.Dock="Left"
                         Width="220"
                         VerticalAlignment="Center"
                         Text="{Binding DefaultWifiEndpoint}"/>
            </DockPanel>

            <DockPanel Margin="0 0 0 12" LastChildFill="False">
                <TextBlock DockPanel.Dock="Left"
                           MinWidth="150"
                           VerticalAlignment="Center"
                           Text="准备 WiFi 目标前探测设备："/>

                <CheckBox DockPanel.Dock="Left"
                          VerticalAlignment="Center"
                          IsChecked="{Binding WifiProbeEnabled}"/>
            </DockPanel>

            <TextBlock MaxWidth="440"
                       Margin="0 0 0 6"
                       HorizontalAlignment="Left"
                       FontSize="12"
                       Opacity="0.7"
                       TextWrapping="Wrap"
                       Text="启动时只会自动连接数据线。连不上时不会弹窗，而是自动把另外两条路准备好：一个蓝牙串口目标（端口已选好设备的蓝牙口）和一个 WiFi 目标（地址已填好），你在「输出目标」面板点对应的连接按钮即可 —— 除了数据线，其余都由你手动连接。"/>

            <TextBlock MaxWidth="440"
                       Margin="0 0 0 6"
                       HorizontalAlignment="Left"
                       FontSize="12"
                       Opacity="0.7"
                       TextWrapping="Wrap"
                       Text="数据线串口匹配按设备 ID 片段来（默认 CH340 的 VID_1A86&amp;PID_7523），多个片段用分号分隔；蓝牙设备名匹配按已配对蓝牙设备的名字来（默认 OSR6），用来找到设备的蓝牙串口。"/>

            <TextBlock MaxWidth="440"
                       Margin="0 0 0 6"
                       HorizontalAlignment="Left"
                       FontSize="12"
                       Opacity="0.7"
                       TextWrapping="Wrap"
                       Text="WiFi 默认地址填设备在路由器里的 IP 和端口（例如 192.168.0.101:8000）。注意电脑必须和设备在同一个网络里，否则无线连不上。"/>

            <TextBlock MaxWidth="440"
                       HorizontalAlignment="Left"
                       FontSize="12"
                       Opacity="0.7"
                       TextWrapping="Wrap"
                       Text="UDP 是无连接的，地址填错也会显示“已连接”；所以默认会在连接前发一条查询指令（D1）确认设备真的有回应。如果你的设备不认这条指令，可以关掉上面那个开关。"/>
        </StackPanel>
    </Grid>
</UserControl>
