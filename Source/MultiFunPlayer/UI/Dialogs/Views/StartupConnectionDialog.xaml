<UserControl x:Class="MultiFunPlayer.UI.Dialogs.Views.StartupConnectionDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:material="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:s="https://github.com/canton7/Stylet"
             d:DesignHeight="300"
             d:DesignWidth="400"
             x:ClassModifier="internal"
             mc:Ignorable="d">
    <DockPanel Width="400"
               Margin="15"
               LastChildFill="False">
        <DockPanel DockPanel.Dock="Bottom"
                   Margin="0 12 0 0"
                   HorizontalAlignment="Right"
                   LastChildFill="False">
            <Button DockPanel.Dock="Right"
                    MinWidth="70"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    Click="{s:Action OnSkip}"
                    Content="跳过"/>

            <Button DockPanel.Dock="Right"
                    MinWidth="90"
                    Margin="0 0 6 0"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    Click="{s:Action OnRetryUsb}"
                    Content="重试 USB"/>
        </DockPanel>

        <TextBlock DockPanel.Dock="Top"
                   Margin="0 0 0 6"
                   FontSize="14"
                   FontWeight="Bold"
                   Text="{Binding Reason}"
                   TextWrapping="Wrap"/>

        <TextBlock DockPanel.Dock="Top"
                   Margin="0 0 0 12"
                   FontSize="12"
                   Opacity="0.7"
                   Text="{Binding Hint}"
                   TextWrapping="Wrap"/>

        <DockPanel DockPanel.Dock="Top"
                   Margin="0 0 0 6"
                   LastChildFill="False">
            <TextBlock DockPanel.Dock="Left"
                       MinWidth="50"
                       VerticalAlignment="Center"
                       Text="蓝牙："/>

            <ComboBox DockPanel.Dock="Left"
                      Width="180"
                      VerticalAlignment="Center"
                      IsEnabled="{Binding CanUseBluetooth}"
                      ItemsSource="{Binding BluetoothPorts}"
                      SelectedItem="{Binding SelectedSerialPort}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <Button DockPanel.Dock="Left"
                    MinWidth="60"
                    Margin="6 0 0 0"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    IsEnabled="{Binding CanUseBluetooth}"
                    Click="{s:Action OnConnectBluetooth}"
                    Content="连接"
                    Foreground="{DynamicResource MaterialDesignSuccessBrush}"/>
        </DockPanel>

        <DockPanel DockPanel.Dock="Top"
                   LastChildFill="False">
            <TextBlock DockPanel.Dock="Left"
                       MinWidth="50"
                       VerticalAlignment="Center"
                       Text="WiFi："/>

            <ComboBox DockPanel.Dock="Left"
                      Width="70"
                      VerticalAlignment="Center"
                      ItemsSource="{Binding WifiProtocols}"
                      SelectedItem="{Binding WifiProtocol}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Converter={StaticResource DescriptionConverter}}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBox DockPanel.Dock="Left"
                     Width="110"
                     Margin="6 0 0 0"
                     VerticalAlignment="Center"
                     Text="{Binding WifiEndpoint}"/>

            <Button DockPanel.Dock="Left"
                    MinWidth="60"
                    Margin="6 0 0 0"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    IsEnabled="{Binding CanUseWifi}"
                    Click="{s:Action OnConnectWifi}"
                    Content="连接"
                    Foreground="{DynamicResource MaterialDesignSuccessBrush}"/>
        </DockPanel>
    </DockPanel>
</UserControl>
