<UserControl x:Class="MultiFunPlayer.UI.Dialogs.Views.HelpDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:material="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="560"
             d:DesignWidth="560"
             x:ClassModifier="internal"
             mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="HelpH1" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0 12 0 6"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryHueMidBrush}"/>
        </Style>
        <Style x:Key="HelpH2" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0 10 0 4"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="HelpH3" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0 6 0 2"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="HelpBody" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0 0 0 4"/>
            <Setter Property="LineHeight" Value="18"/>
        </Style>
        <Style x:Key="HelpItem" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0 0 0 3"/>
            <Setter Property="LineHeight" Value="17"/>
        </Style>
        <Style x:Key="HelpKey" TargetType="{x:Type Run}">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryHueMidBrush}"/>
        </Style>
        <Style x:Key="HelpNote" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0 2 0 6"/>
            <Setter Property="LineHeight" Value="16"/>
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}"/>
            <Setter Property="Opacity" Value="0.7"/>
        </Style>
        <Style x:Key="HelpPane" TargetType="{x:Type ScrollViewer}">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Padding" Value="2 2 10 2"/>
        </Style>
    </UserControl.Resources>

    <DockPanel MinWidth="480"
               MaxWidth="560"
               Margin="15">
        <material:ColorZone DockPanel.Dock="Top"
                            Background="{DynamicResource PrimaryHueMidBrush}"
                            CornerRadius="4 4 0 0">
            <Grid Margin="0 0 0 5">
                <TextBlock Margin="10 8 0 0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryHueMidForegroundBrush}"
                           Text="使用说明"/>

                <Button Style="{StaticResource MaterialDesignFlatButton}"
                        Width="24"
                        Height="24"
                        Margin="0 5 5 0"
                        Padding="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        material:RippleAssist.Feedback="{DynamicResource PrimaryHueMidForegroundBrush}"
                        Command="{x:Static material:DialogHost.CloseDialogCommand}"
                        Foreground="{DynamicResource PrimaryHueMidForegroundBrush}">
                    <material:PackIcon Width="20"
                                       Height="20"
                                       Kind="Close"/>
                </Button>
            </Grid>
        </material:ColorZone>

        <TabControl Height="470">
            <!-- ============================ 快速上手 ============================ -->
            <TabItem Padding="16 0" Header="快速上手">
                <ScrollViewer Style="{StaticResource HelpPane}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource HelpBody}"
                                   Text="MultiFunPlayer 的作用：读取播放器的播放进度，把对应的 funscript 关键帧换算成设备指令，通过串口或网络发给你连接的设备。整个过程是实时跟随的，你在播放器里拖动进度条，设备也会跟着跳到对应位置。"/>

                        <TextBlock Style="{StaticResource HelpBody}"
                                   Text="数据流：媒体源（读进度）→ 脚本（按时间取关键帧）→ 轴（应用偏移/缩放/限速/插值）→ 输出目标（发给设备）。轴上没有脚本时，由运动提供器生成动作填补。"/>

                        <TextBlock Style="{StaticResource HelpH1}" Text="四步上手"/>
                        <TextBlock Style="{StaticResource HelpH2}" Text="① 选择设备"/>
                        <TextBlock Style="{StaticResource HelpBody}"
                                   Text="点右上角齿轮进入「设置 → 设备」，在「当前设备」下拉里选择你的设备型号。设备决定了软件有哪些轴（例如 OSR6 用 TCode 0.3，包含 L0/L1/L2/R0/R1/R2）、每个轴的显示名和输出精度。没找到你的型号可以先随便选一个，再「克隆所选」自定义轴。"/>
                        <TextBlock Style="{StaticResource HelpNote}"
                                   Text="提示：轴上方的「脚本后缀名」决定自动匹配脚本时该轴对应文件名的哪一段，格式为 视频名.后缀名.funscript。想匹配没有后缀的文件就填 *。"/>

                        <TextBlock Style="{StaticResource HelpH2}" Text="② 连接输出设备"/>
                        <TextBlock Style="{StaticResource HelpBody}"
                                   Text="在主界面「输出目标」面板里选连接方式（串口 / TCP / UDP / WebSocket / 管道 / Buttplug / The Handy / 文件），填好参数后点连接。串口是最常用的：选对 COM 口，波特率一般 115200，然后点连接按钮。"/>
                        <TextBlock Style="{StaticResource HelpNote}"
                                   Text="提示：串口的 DTR 与 RTS 必须保持开启（默认即开启），关闭会导致连接直接失败。另外连接瞬间设备可能会自己回一下零位，这是设备固件收到 DTR 信号后重新归位的硬件行为，无法从软件端消除。"/>

                        <TextBlock Style="{StaticResource HelpH2}" Text="③ 连接媒体源并加载脚本"/>
                        <TextBlock Style="{StaticResource HelpBody}"
                                   Text="在「媒体源」面板选择你用的播放器（PotPlayer、MPV、VLC、MPC-HC、HereSphere、DeoVR、Whirligig、OFS，或内置播放器），点连接。用 Plex / Jellyfin / Emby / Stash / XBVR 这类媒体库时，先在「设置」里配置好地址与密钥，软件会在播放时自动搜索并加载脚本。"/>
                        <TextBlock Style="{StaticResource HelpBody}"
                                   Text="也可以手动加载：在「脚本」面板每个轴上点「选择脚本文件」。想让脚本自动匹配，把 .funscript 放在视频同目录，按 视频名.后缀名.funscript 命名即可。"/>

                        <TextBlock Style="{StaticResource HelpH2}" Text="④ 开播并微调"/>
                        <TextBlock Style="{StaticResource HelpBody}"
                                   Text="播放器开始播放后，设备就会跟着动。接下来按需微调：脚本和动作对不上就调该轴的「偏移」「缩放」；方向反了就开「反转脚本」；某些轴没有脚本就用「运动提供器」生成动作；动作太猛就开「速度限制」或「智能限速」。"/>

                        <TextBlock Style="{StaticResource HelpH1}" Text="想更省事的话"/>
                        <TextBlock Style="{StaticResource HelpBody}"
                                   Text="「快捷键」页可以把常用操作（播放暂停、跳转、切换轴状态、一键播放预设等）绑到键盘、鼠标或手柄上，播放时不用切回软件窗口。插件面板可以加载自定义脚本扩展功能，本软件已内置「一键播放预设」插件。"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================ 界面说明 ============================ -->
            <TabItem Padding="16 0" Header="界面说明">
                <ScrollViewer Style="{StaticResource HelpPane}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource HelpH1}" Text="标题栏按钮"/>
                        <TextBlock Style="{StaticResource HelpItem}">
                            <Run Style="{DynamicResource HelpKey}" Text="?"/><Run Text="　打开本说明文档"/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource HelpItem}">
                            <Run Style="{DynamicResource HelpKey}" Text="i"/><Run Text="　关于：版本号、更新检查与项目链接"/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource HelpItem}">
                            <Run Style="{DynamicResource HelpKey}" Text="齿轮"/><Run Text="　设置：设备、主题、输入、快捷键"/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource HelpItem}">
                            <Run Style="{DynamicResource HelpKey}" Text="插头"/><Run Text="　插件：查看插件编译状态与错误信息"/>
                        </TextBlock>

                        <TextBlock Style="{StaticResource HelpH1}" Text="主界面四个面板"/>
                        <TextBlock Style="{StaticResource HelpBody}" Text="从上到下依次是「插件」「媒体源」「脚本」「输出目标」。在设置里把「窗口布局」切到水平，会变成左右两栏，适合宽屏。"/>
                        <TextBlock Style="{StaticResource HelpItem}">
                            <Run Style="{DynamicResource HelpKey}" Text="媒体源"/><Run Text="　选择播放器、连接、显示当前媒体信息"/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource HelpItem}">
                            <Run Style="{DynamicResource HelpKey}" Text="脚本"/><Run Text="　核心面板：媒体控制、时间轴热力图、每个轴的状态与参数"/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource HelpItem}">
                            <Run Style="{DynamicResource HelpKey}" Text="输出目标"/><Run Text="　选择连接方式、连接设备、配置各轴范围"/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource HelpItem}">
                            <Run Style="{DynamicResource HelpKey}" Text="插件"/><Run Text="　插件编译状态、预设管理（内置插件）"/>
                        </TextBlock>

                        <TextBlock Style="{StaticResource HelpH1}" Text="脚本面板"/>
                        <TextBlock Style="{StaticResource HelpH2}" Text="时间轴热力图"/>
                        <TextBlock Style="{StaticResource HelpBody}"
                                   Text="显示整段脚本的动作密度与当前位置，可以拖动定位、框选设置循环区间。右键有显示范围、预览、合并热度、桶数量、Y 轴反转等选项。"/>
                        <TextBlock Style="{StaticResource HelpH2}" Text="轴"/>
                        <TextBlock Style="{StaticResource HelpBody}"
                                   Text="每个轴一行，左侧是该轴的开关与状态标签，右侧是运动提供器等设置。轴前面出现标签时含义如下："/>
                        <TextBlock Style="{StaticResource HelpItem}">
                            <Run Style="{DynamicResource HelpKey}" Text="已禁用"/><Run Text="　该轴输出被关闭，不会发指令"/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource HelpItem}">
                            <Run Style="{DynamicResource HelpKey}" Text="已启用"/><Run Text="　正常输出"/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource HelpItem}">
                            <Run Style="{DynamicResource HelpKey}" Text="锁定"/><Run Text="　锁定脚本，忽略播放进度，保持在当前值"/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource HelpItem}">
                            <Run Style="{DynamicResource HelpKey}" Text="旁路"/><Run Text="　绕过脚本，改由运动提供器输出"/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource HelpItem}">
                            <Run Style="{DynamicResource HelpKey}" Text="覆盖"/><Run Text="　纯脚本播放中：忽略播放器进度，直接按指定脚本循环输出（内置插件功能）"/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource HelpItem}">
                            <Run Style="{DynamicResource HelpKey}" Text="已生效"/><Run Text="　智能限速或速度限制正在起作用"/>
                        </TextBlock>

                        <TextBlock Style="{StaticResource HelpH1}" Text="纯脚本播放（内置插件）"/>
                        <TextBlock Style="{StaticResource HelpBody}"
                                   Text="不需要打开视频，直接把一组 funscript 当作动作源播放。在「插件」面板添加预设（一组脚本文件），之后可以点按钮播放，或绑一个快捷键一键播放。播放时会顶掉当前视频的脚本，手动停止后自动恢复。"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================ 快捷键 ============================ -->
            <TabItem Padding="16 0" Header="快捷键">
                <ScrollViewer Style="{StaticResource HelpPane}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource HelpH1}" Text="怎么创建快捷键"/>
                        <TextBlock Style="{StaticResource HelpBody}" Text="设置 → 快捷键 → 点右上角的捕获按钮，然后按下你要用的键或按下手柄按钮；确认手势后选一个「类型」（决定这个手势怎么触发），填个名字方便识别，再添加要执行的动作。"/>
                        <TextBlock Style="{StaticResource HelpBody}" Text="一个手势可以挂多个动作，按顺序执行。每个动作都可以带参数，参数在动作列表里直接编辑。"/>
                        <TextBlock Style="{StaticResource HelpH2}" Text="手势来源"/>
                        <TextBlock Style="{StaticResource HelpItem}">
                            <Run Style="{DynamicResource HelpKey}" Text="键盘 / 鼠标"/><Run Text="　RawInput 处理器，支持组合键与鼠标按键、滚轮"/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource HelpItem}">
                            <Run Style="{DynamicResource HelpKey}" Text="手柄"/><Run Text="　XInput 处理器，支持按键、扳机与摇杆方向"/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource HelpItem}">
                            <Run Style="{DynamicResource HelpKey}" Text="TCode"/><Run Text="　来自设备端的按钮输入"/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource HelpH2}" Text="类型（触发方式）"/>
                        <TextBlock Style="{StaticResource HelpItem}">
                            <Run Style="{DynamicResource HelpKey}" Text="按键单击"/><Run Text="　按下并松开时触发一次"/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource HelpItem}">
                            <Run Style="{DynamicResource HelpKey}" Text="按键按下"/><Run Text="　按下瞬间触发"/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource HelpItem}">
                            <Run Style="{DynamicResource HelpKey}" Text="按键松开"/><Run Text="　松开瞬间触发"/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource HelpItem}">
                            <Run Style="{DynamicResource HelpKey}" Text="按键长按"/><Run Text="　按住超过设定时长后触发，可选「松开时」或「按住期间」重复"/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource HelpItem}">
                            <Run Style="{DynamicResource HelpKey}" Text="轴驱动"/><Run Text="　摇杆/扳机等模拟量直接驱动某个轴，支持绝对、相对、仅正向、仅负向、摇杆模式"/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource HelpItem}">
                            <Run Style="{DynamicResource HelpKey}" Text="轴偏移"/><Run Text="　模拟量按比例叠加到轴上，可选绝对或摇杆模式"/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource HelpItem}">
                            <Run Style="{DynamicResource HelpKey}" Text="轴阈值"/><Run Text="　模拟量越过阈值时触发，可选上升沿、下降沿、双向"/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource HelpItem}">
                            <Run Style="{DynamicResource HelpKey}" Text="切换启用 / 切换禁用 / 切换翻转"/><Run Text="　切换型输入（如手柄某个开关）"/>
                        </TextBlock>

                        <TextBlock Style="{StaticResource HelpH1}" Text="可用动作总表"/>
                        <TextBlock Style="{StaticResource HelpNote}"
                                   Text="下面括号里是动作在配置文件中的标识。同一动作大多有三个变体：Set 直接设定、Offset 在当前值上增减、Drive 按模拟量驱动。参数里出现「目标轴」时表示该动作作用于指定轴。"/>

                        <TextBlock Style="{StaticResource HelpH2}" Text="媒体控制"/>
                        <TextBlock Style="{StaticResource HelpItem}"><Run Style="{DynamicResource HelpKey}" Text="Media::PlayPause::Set"/><Run Text="　播放 / 暂停"/></TextBlock>
                        <TextBlock Style="{StaticResource HelpItem}"><Run Style="{DynamicResource HelpKey}" Text="Media::Path::Set"/><Run Text="　切换媒体（参数：媒体路径）"/></TextBlock>
                        <TextBlock Style="{StaticResource HelpItem}"><Run Style="{DynamicResource HelpKey}" Text="Media::Position::Time::Set"/><Run Text="　跳到指定时间（数值、数值偏移，秒）"/></TextBlock>
                        <TextBlock Style="{StaticResource HelpItem}"><Run Style="{DynamicResource HelpKey}" Text="Media::Position::Percent::Set"/><Run Text="　跳到指定百分比（数值、数值偏移）"/></TextBlock>
                        <TextBlock Style="{StaticResource HelpItem}"><Run Style="{DynamicResource HelpKey}" Text="Media::Position::SkipToScriptStart"/><Run Text="　跳到脚本起点（偏移，秒）"/></TextBlock>
                        <TextBlock Style="{StaticResource HelpItem}"><Run Style="{DynamicResource HelpKey}" Text="Media::Speed::Set"/><Run Text="　设置播放速度（数值、数值偏移）"/></TextBlock>
                        <TextBlock Style="{StaticResource HelpItem}"><Run Style="{DynamicResource HelpKey}" Text="Media::ScriptOffset::Set"/><Run Text="　脚本时间偏移（数值、数值偏移，秒）"/></TextBlock>
                        <TextBlock Style="{StaticResource HelpItem}"><Run Style="{DynamicResource HelpKey}" Text="Media::Loop::Set"/><Run Text="　设置循环区间（起始偏移、结束偏移）"/></TextBlock>
                        <TextBlock Style="{StaticResource HelpItem}"><Run Style="{DynamicResource HelpKey}" Text="Media::Loop::Set::FromMediaPositionOffset"/><Run Text="　以当前播放位置为基准设循环"/></TextBlock>
                        <TextBlock Style="{StaticResource HelpItem}"><Run Style="{DynamicResource HelpKey}" Text="Media::Loop::Start::Set"/><Run Text="　设置循环起点（位置）"/></TextBlock>
                        <TextBlock Style="{StaticResource HelpItem}"><Run Style="{DynamicResource HelpKey}" Text="Media::Loop::End::Set"/><Run Text="　设置循环终点（位置）"/></TextBlock>
                        <TextBlock Style="{StaticResource HelpItem}"><Run Style="{DynamicResource HelpKey}" Text="Media::Bookmark::SeekToByName"/><Run Text="　跳到指定书签（书签名）"/></TextBlock>
                        <TextBlock Style="{StaticResource HelpItem}"><Run Style="{DynamicResource HelpKey}" Text="Media::Bookmark::SeekToByIndex"/><Run Text="　跳到指定序号书签（书签索引）"/></TextBlock>
                        <TextBlock Style="{StaticResource HelpItem}"><Run Style="{DynamicResource HelpKey}" Text="Media::Chapter::SeekToByName"/><Run Text="　跳到指定章节（章节名）"/></TextBlock>
                        <TextBlock Style="{StaticResource HelpItem}"><Run Style="{DynamicResource HelpKey}" Text="Media::Chapter::SeekToByIndex"/><Run Text="　跳到指定序号章节（章节索引）"/></TextBlock>
                        <TextBlock Style="{StaticResource HelpItem}"><Run Style="{DynamicResource HelpKey}" Text="Media::AutoSkipToScriptStartEnabled::Set"/><Run Text="　启用 / 关闭自动跳到脚本起点"/></TextBlock>
                        <TextBlock Style="{StaticResource HelpItem}"><Run Style="{DynamicResource HelpKey}" Text="Media::AutoSkipToScriptStartOffset::Set"/><Run Text="　自动跳转的偏移（数值，秒）"/></TextBlock>

                        <TextBlock Style="{StaticResource HelpH2}" Text="轴·数值"/>
                        <TextBlock Style="{StaticResource HelpItem}"><Run Style="{DynamicResource HelpKey}" Text="Axis::Value::Set / ::Offset / ::Drive"/><Run Text="　直接设定、增减或按模拟量驱动轴的输出值"/></TextBlock>
                        <TextBlock Style="{StaticResource HelpH2}" Text="轴·脚本"/>
                        <TextBlock Style="{StaticResource HelpItem}"><Run Style="{DynamicResource HelpKey}" Text="Axis::ScriptOffset::Set / ::Offset"/><Run Text="　脚本时间偏移（秒）"/></TextBlock>
                        <TextBlock Style="{StaticResource HelpItem}"><Run Style="{DynamicResource HelpKey}" Text="Axis::ScriptScale::Set / ::Offset"/><Run Text="　脚本值缩放"/></TextBlock>
                        <TextBlock Style="{StaticResource HelpItem}"><Run Style="{DynamicResource HelpKey}" Text="Axis::InvertScript::Set / ::Toggle"/><Run Text="　反转脚本"/></TextBlock>
                        <TextBlock Style="{StaticResource HelpItem}"><Run Style="{DynamicResource HelpKey}" Text="Axis::InterpolationType::Set"/><Run Text="　插值类型（线性 / Pchip / Makima / 阶梯）"/></TextBlock>
                        <TextBlock Style="{StaticResource HelpItem}"><Run Style="{DynamicResource HelpKey}" Text="Axis::ClearScript"/><Run Text="　卸载该轴脚本"/></TextBlock>
                        <TextBlock Style="{StaticResource HelpItem}"><Run Style="{DynamicResource HelpKey}" Text="Axis::ReloadScript"/><Run Text="　重新加载该轴脚本"/></TextBlock>
                        <TextBlock Style="{StaticResource HelpH2}" Text="轴·锁定与旁路"/>
                        <TextBlock Style="{StaticResource HelpItem}"><Run Style="{DynamicResource HelpKey}" Text="Axis::Lock::Set / ::Toggle、Axis::LockAll::Set"/><Run Text="　锁定单轴 / 全部轴"/></TextBlock>
                        <TextBlock Style="{StaticResource HelpItem}"><Run Style="{DynamicResource HelpKey}" Text="Axis::Bypass::All::Set / ::Toggle"/><Run Text="　一键旁路全部"/></TextBlock>
                        <TextBlock Style="{StaticResource HelpItem}"><Run Style="{DynamicResource HelpKey}" Text="Axis::Bypass::Script::Set / ::Toggle"/><Run Text="　旁路脚本"/></TextBlock>
                        <TextBlock Style="{StaticResource HelpItem}"><Run Style="{DynamicResource HelpKey}" Text="Axis::Bypass::MotionProvider::Set / ::Toggle"/><Run Text="　旁路运动提供器"/></TextBlock>
                        <TextBlock Style="{StaticResource HelpItem}"><Run Style="{DynamicResource HelpKey}" Text="Axis::Bypass::Transition::Set / ::Toggle"/><Run Text="　旁路自定义过渡"/></TextBlock>
                        <TextBlock Style="{StaticResource HelpH2}" Text="轴·运动提供器"/>
                        <TextBlock Style="{StaticResource HelpItem}"><Run Style="{DynamicResource HelpKey}" Text="Axis::MotionProvider::Set"/><Run Text="　选择运动提供器（运动提供器）"/></TextBlock>
                        <TextBlock Style="{StaticResource HelpItem}"><Run Style="{DynamicResource HelpKey}" Text="Axis::MotionProviderBlend::Set / ::Offset / ::Drive"/><Run Text="　脚本与运动提供器的混合比例"/></TextBlock>
                        <TextBlock Style="{StaticResource HelpItem}"><Run Style="{DynamicResource HelpKey}" Text="Axis::MotionProviderFillGaps::Set / ::Toggle"/><Run Text="　填充脚本空隙"/></TextBlock>
                        <TextBlock Style="{StaticResource HelpItem}"><Run Style="{DynamicResource HelpKey}" Text="Axis::MotionProviderMinimumGapDuration::Set / ::Offset"/><Run Text="　最小空隙时长（秒）"/></TextBlock>
                        <TextBlock Style="{StaticResource HelpItem}"><Run Style="{DynamicResource HelpKey}" Text="Axis::UpdateMotionProviderWhenPaused::Set / ::Toggle"/><Run Text="　暂停时也更新运动提供器"/></TextBlock>
                        <TextBlock Style="{StaticResource HelpItem}"><Run Style="{DynamicResource HelpKey}" Text="Axis::UpdateMotionProviderWithoutScript::Set / ::Toggle"/><Run Text="　无脚本时也更新"/></TextBlock>
                        <TextBlock Style="{StaticResource HelpItem}"><Run Style="{DynamicResource HelpKey}" Text="Axis::UpdateMotionProviderWithAxis::Set"/><Run Text="　跟随另一个轴更新"/></TextBlock>
                        <TextBlock Style="{StaticResource HelpH2}" Text="轴·智能限速与速度限制"/>
                        <TextBlock Style="{StaticResource HelpItem}"><Run Style="{DynamicResource HelpKey}" Text="Axis::SmartLimitMode::Set"/><Run Text="　智能限速模式（数值 / 速度）"/></TextBlock>
